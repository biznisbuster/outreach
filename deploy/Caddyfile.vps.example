# ============================================================================
# Caddy — primer za sistemski Caddy na VPS-u (NE u Docker-u)
# ----------------------------------------------------------------------------
# Kako koristiti:
#   1. Zameni `outreach.example.com` sa svojim domenom.
#   2. Sačuvaj kao /etc/caddy/sites/outreach.caddy (ili gde želiš).
#   3. U glavni /etc/caddy/Caddyfile dodaj:
#        import /etc/caddy/sites/*.caddy
#   4. Otvori port 80 i 443 na hostu (Caddy radi ACME HTTP-01).
#   5. systemctl reload caddy
#
# docker compose -f docker-compose.vps.yml izlaže gui-astro samo na
# 127.0.0.1:3000 — Caddy proxy-uje sa :443 na tu adresu.
# ============================================================================

outreach.example.com {
    encode zstd gzip

    # Prosleđuje headere koje Next/Astro očekuje iza reverse proxy-ja:
    # AUTH_TRUST_HOST=true u compose env već radi, ali X-Forwarded-* je
    # dobra praksa i za logove.
    reverse_proxy 127.0.0.1:3000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Opciono: ograniči pristup po IP-u (npr. samo tvoj office)
    # @blocked not remote_ip 1.2.3.4 5.6.7.0/24
    # respond @blocked 403

    # Opciono: rate limiting na /api/* (Caddy bez plugina je ograničen;
    # za pravo rate limiting dodaj caddy-ratelimit modul ili koristi
    # Cloudflare/AWS prednji proxy.)
}


