# ============================================================
# Outreach — primer .env fajla (kopiraj u .env i popuni)
# ============================================================
# Za lokalni dev:         docker compose -f docker-compose.astro.yml up -d --build
# Za VPS (produkcija):    ./deploy/setup-vps.sh
#                         docker compose -f docker-compose.vps.yml --env-file .env up -d --build
# Detalji u deploy/README.md.

# --- Baza ---
# SINGLE SOURCE OF TRUTH: data/outreach.db (relativno od /web).
# Ovo je isti fajl koji koristi Docker (/data je mount na isti path u kontejneru).
# NIKAD ne stvaraj outreach.db pod web/ — obriši ako se slučajno pojavi.
DATABASE_URL=file:../data/outreach.db

# --- VPS deployment (automatski dodaje deploy/setup-vps.sh) ---
# Apsolutna putanja do data foldera na HOSTU (van repo). NE stavljaj ~ — Compose
# ne expanduje tilda. Default: $HOME/outreach-data/
OUTREACH_DATA_DIR=/home/USER/outreach-data
# UID/GID vlasnika data foldera — gui-astro alpine `node` user je 1000:1000.
# Ako tvoj VPS user ima drugi UID, overriduj (id -u / id -g na hostu).
UID=1000
GID=1000

# --- Auth ---
# Opcija A (preporučeno): plain šifra — seed hešuje u letu.
# Opcija B: već gotov bcrypt hash (opasno u .env zbog $ escape — koristi Opciju A).
# Generiši hash: node -e "console.log(require('bcryptjs').hashSync('TVOJA_SIFRA', 10))"
AUTH_PASSWORD=tvoja-šifra
# AUTH_PASSWORD_HASH=$2a$10$REPLACE_WITH_BCRYPT_HASH
# Sledeći random string (npx auth secret)
AUTH_SECRET=replace-with-32-byte-random-hex
# Kada se app servira iza Caddy reverse proxy-ja
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://localhost

# --- Enkripcija SMTP šifri (AES-256-GCM) ---
# 32 bajta hex (64 karaktera). Generiši: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars

# --- Scraper servis ---
SCRAPER_URL=http://scraper:8001

# --- MiniMax M3 ---
MINIMAX_API_KEY=replace-with-your-token
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

# --- IMAP (reply tracking) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=marko@tvojdomen.rs
IMAP_PASSWORD=app-password
IMAP_FOLDER=INBOX

# --- Slanje: podrazumevani limiti ---
DEFAULT_SENDER_HOURLY_CAP=10
DEFAULT_SENDER_DAILY_CAP=50

# --- Prozor slanja (Europe/Belgrade, pon–pet) ---
SEND_WINDOW_START=09:00
SEND_WINDOW_END=17:00
SEND_WINDOW_TZ=Europe/Belgrade
SEND_WINDOW_DAYS=mon-fri

# --- Unsubscribe link ---
UNSUBSCRIBE_BASE_URL=https://outreach.tvojdomen.rs
