# Server
PORT=3000
HOST=0.0.0.0

# ─── Baza — ISTI FAJL kao web/ (data/outreach.db) ───
# Lokalni dev: file:../data/outreach.db
# Docker compose: file:/data/outreach.db (volume /data deli isti host dir)
DATABASE_URL=file:../data/outreach.db

# ─── Auth ───
# Plain šifra — seed.ts hešuje u letu.
# (AUTH_PASSWORD_HASH radi, ali $ u .env escape-uje shell — prefer plain.)
AUTH_PASSWORD=outreach123

# Random 32-byte hex za cookie HMAC
AUTH_SECRET=replace-with-32-byte-random-hex

# 32 bajta hex (64 karaktera) za AES-256-GCM SMTP šifri
ENCRYPTION_KEY=replace-with-64-hex-chars

# ─── Scraper servisi (Python sidecari) ───
SCRAPER_URL=http://127.0.0.1:8001
SCRAPER_LEADS_URL=http://127.0.0.1:8002

# ─── IMAP (reply tracking) ───
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_MINUTES=5

# ─── Slanje ───
DEFAULT_SENDER_HOURLY_CAP=10
DEFAULT_SENDER_DAILY_CAP=50
SEND_WINDOW_START=09:00
SEND_WINDOW_END=17:00
SEND_WINDOW_TZ=Europe/Belgrade
SEND_WINDOW_DAYS=mon-fri

# ─── Unsubscribe ───
UNSUBSCRIBE_BASE_URL=https://localhost

# ─── Scheduler ───
SCHEDULER_ENABLED=1
SCHEDULER_TICK_MS=60000
