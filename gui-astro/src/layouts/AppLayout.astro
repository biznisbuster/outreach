---
import "../styles/globals.css";
import Sidebar from "../components/Sidebar.astro";
import MobileTopBar from "../components/MobileTopBar.astro";
import Toaster from "../components/Toaster.astro";
import CommandPalette from "../components/CommandPalette.astro";

interface Props {
  title?: string;
  description?: string;
}
const { title = "Outreach", description = "B2B cold outreach platforma" } = Astro.props;
---
<!doctype html>
<html lang="sr" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a14" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <title>{title}</title>
    {/* Pre-paint theme set: avoid FOUC. Čita localStorage i postavlja dark klasu + colorScheme pre prvog render-a. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("app_theme");
          var isDark = t === "dark";
          var root = document.documentElement;
          if (isDark) root.classList.add("dark");
          else root.classList.remove("dark");
          root.style.colorScheme = isDark ? "dark" : "light";
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="h-full bg-background text-foreground antialiased">
    <!-- Mobile top bar (samo <md). Stiže ispod fixed app-drawer z-indexa da drawer prekrije. -->
    <MobileTopBar />

    <div class="flex h-screen md:h-screen overflow-hidden">
      <!-- Desktop sidebar: vidljiv samo >= md, kolapsibilan. -->
      <Sidebar />

      <!-- Mobile drawer: vidljiv samo <md, slide-in sa leva. -->
      <Sidebar variant="drawer" />

      <!-- Backdrop za drawer (samo <md). -->
      <div
        id="mobile-sidebar-backdrop"
        class="app-drawer-backdrop md:hidden fixed inset-0 z-40 bg-black/50"
        data-backdrop-state="closed"
        aria-hidden="true"
      ></div>

      <!-- Main: na mobilnom, padding-top za MobileTopBar; na desktopu nema top bar. -->
      <main class="flex-1 overflow-y-auto pt-14 md:pt-0">
        <slot />
      </main>
    </div>
    <Toaster />
    <CommandPalette />

    <!-- Mobile drawer state machine (jedan jedini izvor istine). -->
    <script is:inline>
      (function () {
        var drawer = document.getElementById("mobile-sidebar-drawer");
        var backdrop = document.getElementById("mobile-sidebar-backdrop");
        var hamburger = document.getElementById("mobile-sidebar-toggle");
        if (!drawer || !backdrop) return;

        function isOpen() {
          return drawer.getAttribute("data-drawer-state") === "open";
        }

        function openDrawer() {
          drawer.setAttribute("data-drawer-state", "open");
          backdrop.setAttribute("data-backdrop-state", "open");
          document.body.classList.add("no-scroll");
          if (hamburger) hamburger.setAttribute("aria-expanded", "true");
        }

        function closeDrawer() {
          drawer.setAttribute("data-drawer-state", "closed");
          backdrop.setAttribute("data-backdrop-state", "closed");
          document.body.classList.remove("no-scroll");
          if (hamburger) hamburger.setAttribute("aria-expanded", "false");
        }

        function toggleDrawer() {
          if (isOpen()) closeDrawer(); else openDrawer();
        }

        // Expose globally for other components (MobileTopBar, Sidebar)
        window.__mobileDrawerOpen = openDrawer;
        window.__mobileDrawerClose = closeDrawer;
        window.__mobileDrawerToggle = toggleDrawer;

        // Backdrop click closes
        backdrop.addEventListener("click", closeDrawer);

        // ESC closes
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && isOpen()) {
            closeDrawer();
          }
        });

        // Auto-close on resize past breakpoint (ako korisnik rotira telefon ili resize-uje prozor)
        var mq = window.matchMedia("(min-width: 768px)");
        function handleMq(e) {
          if (e.matches && isOpen()) closeDrawer();
        }
        if (mq.addEventListener) mq.addEventListener("change", handleMq);
        else if (mq.addListener) mq.addListener(handleMq); // older Safari
      })();
    </script>
  </body>
</html>
