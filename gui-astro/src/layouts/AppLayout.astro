---
import "../styles/globals.css";
import Sidebar from "../components/Sidebar.astro";
import Toaster from "../components/Toaster.astro";
import CommandPalette from "../components/CommandPalette.astro";

interface Props {
  title?: string;
  description?: string;
}
const { title = "Outreach", description = "B2B cold outreach platforma" } = Astro.props;
---
<!doctype html>
<html lang="sr" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <title>{title}</title>
    {/* Pre-paint theme set: avoid FOUC. Čita localStorage i postavlja dark klasu + colorScheme pre prvog render-a. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("app_theme");
          var isDark = t === "dark";
          var root = document.documentElement;
          if (isDark) root.classList.add("dark");
          else root.classList.remove("dark");
          root.style.colorScheme = isDark ? "dark" : "light";
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="h-full bg-background text-foreground antialiased">
    <div class="flex h-screen overflow-hidden">
      <Sidebar />
      <main class="flex-1 overflow-y-auto">
        <slot />
      </main>
    </div>
    <Toaster />
    <CommandPalette />
  </body>
</html>
