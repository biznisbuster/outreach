---
import AppLayout from "../layouts/AppLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Banner from "../components/Banner.astro";
import StatusBadge from "../components/StatusBadge.astro";
import Table from "../components/Table.astro";
import EmptyState from "../components/EmptyState.astro";
import Button from "../components/Button.astro";
import Avatar from "../components/Avatar.astro";
import { getDb, schema } from "../lib/db";
import { desc, sql, inArray, eq, and } from "drizzle-orm";
import { formatDate } from "../lib/utils";
import {
  QUEUE_STATUS_META,
  QUEUE_OPEN_STATUSES,
  QUEUE_STATUS_ORDER,
  queueStatusMeta,
} from "../lib/queueMeta";

const db = getDb();
const ok = Astro.url.searchParams.get("ok");
const error = Astro.url.searchParams.get("error");

// Handle POST (manual tick)
if (Astro.request.method === "POST") {
  const { processQueue } = await import("../lib/workers/scheduler");
  try {
    const r = await processQueue();
    return Astro.redirect(
      `/queue?ok=${encodeURIComponent(`Tick: sent=${r.sent} skipped=${r.skipped} failed=${r.failed}`)}`,
      303,
    );
  } catch (e) {
    return Astro.redirect(
      `/queue?error=${encodeURIComponent("Greška: " + (e as Error).message)}`,
      303,
    );
  }
}

// Filter: "open" (default) | specifičan status | "all"
const statusFilter = Astro.url.searchParams.get("status") ?? "open";
const conds = [];
if (statusFilter === "open") {
  conds.push(inArray(schema.emailSends.status, QUEUE_OPEN_STATUSES));
} else if (statusFilter !== "all") {
  conds.push(eq(schema.emailSends.status, statusFilter));
}
const where = conds.length ? and(...conds) : undefined;

const items = db
  .select({
    emailSend: schema.emailSends,
    leadName: schema.leads.name,
    leadEmail: schema.leads.email,
    campaignName: schema.campaigns.name,
    senderEmail: schema.senders.email,
  })
  .from(schema.emailSends)
  .leftJoin(schema.leads, eq(schema.leads.id, schema.emailSends.leadId))
  .leftJoin(schema.campaigns, eq(schema.campaigns.id, schema.leads.campaignId))
  .leftJoin(schema.senders, eq(schema.senders.id, schema.emailSends.senderId))
  .where(where)
  .orderBy(desc(schema.emailSends.queuedAt), desc(schema.emailSends.id))
  .limit(200)
  .all();

// Brojevi po statusu za progress bar
const countsRaw = db
  .select({ status: schema.emailSends.status, n: sql<number>`count(*)` })
  .from(schema.emailSends)
  .groupBy(schema.emailSends.status)
  .all();

const counts: Record<string, number> = {};
for (const c of countsRaw) counts[c.status] = Number(c.n);
const total = Object.values(counts).reduce((a, b) => a + b, 0);
const maxCount = Math.max(1, ...Object.values(counts));
---
<AppLayout title="Red slanja — Outreach">
  <div>
    <PageHeader
      title="Red slanja"
      subtitle={`${items.length} emailova · ukupno ${total} u bazi`}
      sticky
    >
      <form method="POST" slot="actions">
        <Button type="submit" variant="primary" icon="loader">
          Pokreni tick
        </Button>
      </form>
    </PageHeader>

    <div class="space-y-6 p-4 md:p-6">
      {ok && <Banner kind="success" message={ok} dismissible />}
      {error && <Banner kind="error" message={error} dismissible />}

      <!-- Status overview: mini progress bar po statusu -->
      {total > 0 && (
        <div class="rounded-lg border border-border bg-card p-4 shadow-xs">
          <div class="mb-3 flex items-center justify-between">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              Status pregled
            </h2>
            <span class="text-xs text-muted-foreground">
              Klikni traku za filter
            </span>
          </div>
          <div class="grid gap-2" style="grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));">
            {QUEUE_STATUS_ORDER.map((status) => {
              const meta = QUEUE_STATUS_META[status];
              const count = counts[status] ?? 0;
              const pct = (count / maxCount) * 100;
              const active = statusFilter === status;
              const inOpen = statusFilter === "open" && QUEUE_OPEN_STATUSES.includes(status);
              return (
                <a
                  href={`/queue?status=${status}`}
                  class={`group relative flex flex-col gap-2 rounded-md border p-3 transition-all duration-150 press ${
                    active || inOpen
                      ? "border-primary/40 bg-primary-soft shadow-sm"
                      : "border-border bg-card hover:border-primary/30 hover:bg-accent"
                  }`}
                  title={meta.hint ?? meta.label}
                  aria-label={`${meta.label}: ${count} emailova`}
                >
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5">
                      <span
                        class="h-2 w-2 shrink-0 rounded-full ring-2 ring-background"
                        style={`background:${meta.color}`}
                        aria-hidden="true"
                      />
                      <span class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                        {meta.label}
                      </span>
                    </div>
                    <span class="text-lg font-bold leading-none tabular-nums text-foreground">{count}</span>
                  </div>
                  <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                    <div
                      class="h-full rounded-full transition-all duration-500 ease-out"
                      style={`width:${pct}%;background:${meta.color};box-shadow:0 0 8px ${meta.color}40`}
                    />
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- Filter chipovi -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
          Filter:
        </span>
        {[
          { key: "open", label: "Otvoreni", icon: "list-checks" },
          { key: "sent", label: "Poslati", icon: "check-circle" },
          { key: "failed", label: "Neuspešni", icon: "alert-triangle" },
          { key: "all", label: "Svi", icon: "inbox" },
        ].map((chip) => (
          <a
            href={`/queue?status=${chip.key}`}
            class:list={[
              "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-medium transition-colors press",
              statusFilter === chip.key
                ? "border-primary bg-primary-soft text-primary"
                : "border-border bg-card text-muted-foreground hover:bg-accent hover:text-foreground",
            ]}
            aria-current={statusFilter === chip.key ? "page" : undefined}
          >
            {chip.label}
          </a>
        ))}
      </div>

      <!-- Tabela (≥sm) -->
      <div class="hidden sm:block">
      <Table padded>
        <thead class="border-b border-border bg-muted/30 text-left text-xs uppercase tracking-wider text-muted-foreground">
          <tr>
            <th class="px-4 py-2.5 font-semibold">Lead</th>
            <th class="px-4 py-2.5 font-semibold">Subject</th>
            <th class="px-4 py-2.5 font-semibold">Status</th>
            <th class="px-4 py-2.5 font-semibold">Sender</th>
            <th class="hidden px-4 py-2.5 font-semibold md:table-cell">Kampanja</th>
            <th class="hidden px-4 py-2.5 font-semibold lg:table-cell">Queued</th>
            <th class="px-4 py-2.5 font-semibold">Reply</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border">
          {items.length === 0 ? (
            <tr>
              <td colspan="7" class="px-4 py-0">
                <EmptyState
                  icon="inbox"
                  title="Nema emailova u ovom filteru"
                  description={
                    statusFilter === "open"
                      ? "Nema emailova u statusima Skica, U redu ili Šalje se. Sve je završeno ili nije zakazano."
                      : "Promeni filter ili pokreni tick da generišeš nove emailove."
                  }
                />
              </td>
            </tr>
          ) : (
            items.map((it) => {
              const meta = queueStatusMeta(it.emailSend.status);
              const queuedIso = it.emailSend.queuedAt
                ? new Date(it.emailSend.queuedAt).toISOString()
                : "";
              return (
                <tr>
                  <td class="px-4 py-2.5">
                    <div class="flex items-center gap-2.5">
                      <Avatar name={it.leadName} size={32} />
                      <div class="min-w-0 flex-1">
                        {it.leadName ? (
                          <a
                            href={`/leads/${it.emailSend.leadId}`}
                            class="block truncate text-sm font-medium text-foreground transition-colors hover:text-primary"
                          >
                            {it.leadName}
                          </a>
                        ) : (
                          <span class="text-sm text-muted-foreground">#{it.emailSend.leadId}</span>
                        )}
                        <div class="truncate text-xs text-muted-foreground">
                          {it.leadEmail ?? "—"}
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="max-w-xs px-4 py-2.5">
                    <div class="truncate text-sm" title={it.emailSend.subject || ""}>
                      {it.emailSend.subject || (
                        <span class="text-muted-foreground">—</span>
                      )}
                    </div>
                  </td>
                  <td class="px-4 py-2.5">
                    {meta ? (
                      <StatusBadge name={meta.label} color={meta.color} size="sm" />
                    ) : (
                      <span class="text-xs text-muted-foreground">
                        {it.emailSend.status}
                      </span>
                    )}
                  </td>
                  <td class="px-4 py-2.5">
                    <span class="font-mono text-xs text-muted-foreground">
                      {it.senderEmail ?? "—"}
                    </span>
                  </td>
                  <td class="hidden px-4 py-2.5 text-xs text-muted-foreground md:table-cell">
                    {it.campaignName ?? "—"}
                  </td>
                  <td class="hidden px-4 py-2.5 text-xs text-muted-foreground lg:table-cell">
                    {queuedIso ? (
                      <time datetime={queuedIso} title={formatDate(it.emailSend.queuedAt)}>
                        {formatDate(it.emailSend.queuedAt)}
                      </time>
                    ) : (
                      <span class="text-muted-foreground">—</span>
                    )}
                  </td>
                  <td class="px-4 py-2.5">
                    {it.emailSend.replied ? (
                      <div class="flex flex-col gap-0.5">
                        <StatusBadge name="Odgovor" color="#22c55e" size="sm" />
                        <span class="hidden text-[10px] text-muted-foreground xl:block">
                          {formatDate(it.emailSend.repliedAt)}
                        </span>
                      </div>
                    ) : (
                      <span class="text-xs text-muted-foreground">—</span>
                    )}
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </Table>
      </div>

      <!-- Mobile card stack (<sm) -->
      <div class="space-y-2 sm:hidden">
        {items.length === 0 ? (
          <EmptyState
            icon="inbox"
            title="Nema emailova u ovom filteru"
            description={
              statusFilter === "open"
                ? "Nema emailova u statusima Skica, U redu ili Šalje se. Sve je završeno ili nije zakazano."
                : "Promeni filter ili pokreni tick da generišeš nove emailove."
            }
          />
        ) : items.map((it) => {
          const meta = queueStatusMeta(it.emailSend.status);
          const queuedIso = it.emailSend.queuedAt ? new Date(it.emailSend.queuedAt).toISOString() : "";
          return (
            <a href={`/leads/${it.emailSend.leadId}`} class="block rounded-lg border border-border bg-card p-3 transition-colors hover:border-primary/40 hover:bg-accent/30 active:bg-accent/50">
              <div class="flex items-start gap-2">
                <Avatar name={it.leadName} size={36} />
                <div class="min-w-0 flex-1">
                  <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0 flex-1">
                      <div class="truncate text-sm font-semibold text-foreground">
                        {it.leadName ?? `#${it.emailSend.leadId}`}
                      </div>
                      <div class="truncate text-[11px] text-muted-foreground">{it.leadEmail ?? "—"}</div>
                    </div>
                    {meta ? <StatusBadge name={meta.label} color={meta.color} size="sm" /> : null}
                  </div>
                  <div class="mt-1 truncate text-xs text-foreground/80">
                    {it.emailSend.subject || <span class="text-muted-foreground">Bez subjekta</span>}
                  </div>
                  <div class="mt-1.5 flex flex-wrap items-center gap-2 text-[11px] text-muted-foreground">
                    {it.senderEmail && <span class="font-mono">✉ {it.senderEmail}</span>}
                    {it.campaignName && <span>· {it.campaignName}</span>}
                    {queuedIso && (
                      <span>· {formatDate(it.emailSend.queuedAt)}</span>
                    )}
                    {it.emailSend.replied && (
                      <span class="font-medium text-success">✓ Odgovor</span>
                    )}
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</AppLayout>