<script is:inline define:vars={{ LEAD_ID: id }}>
  (function () {
    var leadId = LEAD_ID;

    // === Helper: toast wrapper if available ===
    function toast(msg, kind) {
      try { if (typeof window.flash === "function") window.flash(msg, kind || "info"); } catch (e) {}
    }

    // === Save indicator controller ===
    var indicator = document.getElementById("contact-save-indicator");
    var indicatorIcon = indicator ? indicator.querySelector("[data-indicator-icon]") : null;
    var indicatorText = indicator ? indicator.querySelector("[data-indicator-text]") : null;
    var saveHideTimer = null;
    function setIndicator(state, msg) {
      if (!indicator) return;
      indicator.setAttribute("data-state", state);
      var labels = {
        idle:    { icon: "",         text: "Spreman" },
        saving:  { icon: "⏳",       text: "Čuvam…" },
        saved:   { icon: "✓",         text: "Sačuvano" },
        error:   { icon: "⚠",        text: "Greška" },
      };
      var l = labels[state] || labels.idle;
      if (indicatorIcon) indicatorIcon.textContent = l.icon;
      if (indicatorText) indicatorText.textContent = msg || l.text;
      indicator.style.opacity = "1";
      if (saveHideTimer) clearTimeout(saveHideTimer);
      if (state === "saved") {
        saveHideTimer = setTimeout(function () { indicator.style.opacity = "0.4"; }, 1500);
      }
    }

    // === EditableField inputs — PATCH on blur ===
    var debouncers = {};
    function coerce(fieldName, raw) {
      if (raw === "" || raw == null) return null;
      // Numeric fields
      if (fieldName === "googleRating") {
        var n = parseFloat(String(raw).replace(",", "."));
        return isNaN(n) ? null : n;
      }
      if (fieldName === "reviewsCount") {
        var n = parseInt(String(raw), 10);
        return isNaN(n) ? null : n;
      }
      return String(raw);
    }
    document.querySelectorAll("[data-edit-field]").forEach(function (el) {
      var fieldName = el.getAttribute("data-edit-field");
      if (!fieldName) return;

      function save() {
        var val = el.value;
        // Skip if value matches what we last sent (avoids blur->save loops when no change happened)
        if (el.getAttribute("data-last-saved") === val) return;
        setIndicator("saving");
        var body = {};
        body[fieldName] = coerce(fieldName, val);
        fetch("/api/leads/" + leadId, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        }).then(function (r) {
          if (r.ok) {
            setIndicator("saved");
            el.setAttribute("data-last-saved", val);
          } else {
            setIndicator("error", "HTTP " + r.status);
            toast("Greška pri čuvanju " + fieldName, "error");
          }
        }).catch(function (err) {
          setIndicator("error", err && err.message ? err.message : "Greška");
        });
      }

      el.addEventListener("blur", function () {
        // small debounce so the user can tab through without spamming
        clearTimeout(debouncers[fieldName]);
        debouncers[fieldName] = setTimeout(save, 300);
      });
      el.addEventListener("keydown", function (e) {
        if (e.key === "Enter" && el.tagName !== "TEXTAREA") {
          el.blur();
        }
      });
    });

    // === Header status select — PATCH on change ===
    var statusSel = document.getElementById("header-status-select");
    var statusInitial = statusSel ? (statusSel.getAttribute("data-initial-status") || "") : "";
    if (statusSel) {
      statusSel.addEventListener("change", function () {
        var v = statusSel.value;
        if (v === "__add__") { openStatusModal(); statusSel.value = statusInitial; return; }
        var payload = { statusId: v === "__none__" ? null : Number(v) };
        fetch("/api/leads/" + leadId, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        }).then(function (r) {
          if (r.ok) {
            toast("Status ažuriran", "success");
            statusInitial = v;
          } else {
            toast("Greška pri čuvanju statusa", "error");
            statusSel.value = statusInitial;
          }
        }).catch(function () {
          toast("Greška pri čuvanju statusa", "error");
          statusSel.value = statusInitial;
        });
      });
    }

    // === Status create modal (inline) ===
    var modal;
    var colors = [
      "#64748b","#ef4444","#f97316","#f59e0b","#eab308",
      "#84cc16","#22c55e","#10b981","#14b8a6","#06b6d4",
      "#0ea5e9","#3b82f6","#6366f1","#8b5cf6","#a855f7",
      "#d946ef","#ec4899","#6b7280"
    ];
    function openStatusModal() {
      var dlg = document.getElementById("status-create-modal");
      if (!dlg) return;
      try { dlg.showModal(); } catch (e) { console.error(e); }
      setTimeout(function () {
        var n = dlg.querySelector("[name='name']");
        if (n) n.focus();
      }, 30);
    }
    var dlgEl = document.getElementById("status-create-modal");
    if (dlgEl) {
      // wire submit
      dlgEl.addEventListener("click", function (e) {
        if (e.target === dlgEl) dlgEl.close();
      });
      var submitBtn = dlgEl.querySelector(".js-status-submit");
      var formEl = dlgEl.querySelector("[data-status-form]");
      var msgEl = dlgEl.querySelector("[data-status-msg]");
      var closeBtn = dlgEl.querySelector("[data-status-close]");
      if (closeBtn) closeBtn.addEventListener("click", function () { dlgEl.close(); });
      if (submitBtn && formEl) {
        submitBtn.addEventListener("click", function () {
          var payload = {
            name: (formEl.querySelector("[name='name']") || {}).value || "",
            color: (formEl.querySelector("[name='color']:checked") || {}).value || "#3b82f6",
            isTerminalWon: !!((formEl.querySelector("[name='isTerminalWon']") || {}).checked),
            isTerminalLost: !!((formEl.querySelector("[name='isTerminalLost']") || {}).checked),
          };
          if (!payload.name.trim()) {
            if (msgEl) { msgEl.textContent = "Ime je obavezno."; msgEl.className = "text-sm text-red-600"; }
            return;
          }
          submitBtn.disabled = true;
          if (msgEl) { msgEl.className = "hidden"; }
          fetch("/api/statuses", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
          .then(function (res) {
            if (!res.ok) {
              if (msgEl) {
                msgEl.textContent = (res.d && res.d.error) || ("HTTP " + res.ok);
                msgEl.className = "text-sm text-red-600";
              }
              return;
            }
            // add to header select
            if (statusSel) {
              var opt = document.createElement("option");
              opt.value = String(res.d.id);
              opt.textContent = res.d.name;
              opt.style.color = res.d.color;
              // insert before "__none__"
              var noneOpt = statusSel.querySelector("option[value='__none__']");
              if (noneOpt) statusSel.insertBefore(opt, noneOpt);
              else statusSel.appendChild(opt);
              statusSel.value = String(res.d.id);
              statusSel.dispatchEvent(new Event("change"));
            }
            if (msgEl) {
              msgEl.textContent = "Sačuvano.";
              msgEl.className = "text-sm text-success";
            }
            setTimeout(function () { dlgEl.close(); if (msgEl) msgEl.className = "hidden"; }, 600);
          }).catch(function (err) {
            if (msgEl) {
              msgEl.textContent = (err && err.message) || "Greška";
              msgEl.className = "text-sm text-red-600";
            }
          }).then(function () { submitBtn.disabled = false; });
        });
      }
    }
  })();
</script>

<script is:inline>
  (function () {
    // === Site scrape progress ===
    var startBtn = document.getElementById("start-site-scrape");
    var progressBox = document.getElementById("site-scrape-progress");
    var stageEl = document.getElementById("ssp-stage");
    var countEl = document.getElementById("ssp-count");
    var barEl = document.getElementById("ssp-bar");
    var msgEl = document.getElementById("ssp-msg");
    var pollHandle = null;

    function setProgress(stage, count, total, msg) {
      stageEl.textContent = stage || "U toku…";
      countEl.textContent = count + " / " + (total || "?");
      var pct = total > 0 ? Math.min(100, Math.round((count / total) * 100)) : 0;
      barEl.style.width = pct + "%";
      msgEl.textContent = msg || "";
    }

    async function pollStatus(jobId) {
      try {
        var r = await fetch("/api/scrape/status/" + jobId, { headers: { "Origin": location.origin } });
        if (!r.ok) return;
        var d = await r.json();
        // Mapiraj scraper job stanje na progress UI.
        // Job ima: status (running/done/error), pages_scraped, total_pages, screenshot
        var stage = d.status === "done" ? "✅ Gotovo"
                  : d.status === "error" ? "❌ Greška"
                  : d.pages_scraped > 0 ? "Scrape stranica"
                  : "Tražim sitemap";
        var msg = "";
        if (d.error) msg = d.error;
        else if (d.pages_scraped === 0 && d.total_pages === 0) msg = "Skeniram sitemap…";
        else if (d.pages_scraped < d.total_pages) msg = "Scrape-ujem stranu " + (d.pages_scraped + 1) + " od " + d.total_pages;
        else if (d.screenshot) msg = "Screenshot sačuvan";
        setProgress(stage, d.pages_scraped || 0, d.total_pages || 0, msg);
        if (d.status === "done" || d.status === "error") {
          if (pollHandle) { clearInterval(pollHandle); pollHandle = null; }
          startBtn.disabled = false;
          startBtn.textContent = "🔄 Ponovo scrape sajta";
          if (d.status === "done") {
            // Auto-reload posle 1.2s da se prikaže novi screenshot
            reloadTimer = setTimeout(function () { window.location.reload(); }, 1200);
          }
        }
      } catch (e) {
        msgEl.textContent = "Polling greška: " + e.message;
      }
    }

    if (startBtn) {
      startBtn.addEventListener("click", async function () {
        var leadId = startBtn.getAttribute("data-lead-id");
        if (!leadId) return;
        // Ako je već u toku, ignoriši
        if (pollHandle) return;
        startBtn.disabled = true;
        startBtn.textContent = "⏳ Pokrećem…";
        progressBox.classList.remove("hidden");
        setProgress("Pokrećem…", 0, 0, "Šaljem zahtev scraper-u");
        try {
          var r = await fetch("/api/scrape", {
            method: "POST",
            headers: { "Content-Type": "application/json", "Origin": location.origin },
            body: JSON.stringify({ leadId: Number(leadId) }),
          });
          var d = await r.json();
          if (!r.ok || !d.jobId) {
            throw new Error(d.error || "Scraper greška");
          }
          pollHandle = setInterval(function () { pollStatus(d.jobId); }, 1500);
          pollStatus(d.jobId);
        } catch (e) {
          setProgress("❌ Greška", 0, 0, e.message);
          startBtn.disabled = false;
          startBtn.textContent = "🔄 Pokreni scrape sajta";
        }
      });
    }

    // === Screenshot lightbox ===
    var lb = document.getElementById("screenshot-lightbox");
    var lbImg = document.getElementById("lb-img");
    var lbCap = document.getElementById("lb-caption");
    var lbClose = document.getElementById("lb-close");
    var lbOpen = document.getElementById("lb-open-new");

    function openLightbox(src, caption) {
      if (!lb) return;
      lbImg.src = src;
      lbCap.textContent = caption || "";
      lbOpen.setAttribute("data-src", src);
      lb.classList.remove("hidden");
      lb.classList.add("flex");
      document.body.style.overflow = "hidden";
    }
    function closeLightbox() {
      if (!lb) return;
      lb.classList.add("hidden");
      lb.classList.remove("flex");
      lbImg.src = "";
      document.body.style.overflow = "";
    }
    document.querySelectorAll(".screenshot-thumb").forEach(function (btn) {
      btn.addEventListener("click", function () {
        openLightbox(btn.getAttribute("data-src"), btn.getAttribute("data-caption"));
      });
    });
    if (lbClose) lbClose.addEventListener("click", closeLightbox);
    if (lbOpen) lbOpen.addEventListener("click", function () {
      var src = lbOpen.getAttribute("data-src");
      if (src) window.open(src, "_blank");
    });
    if (lb) {
      // Klik na pozadinu (ne na sliku) zatvara
      lb.addEventListener("click", function (e) {
        if (e.target === lb || e.target === lbCap) closeLightbox();
      });
    }
    // ESC zatvara
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeLightbox();
    });

    // === Tab switching (Overview / Site Audit) ===
    (function () {
      var tabs = document.querySelectorAll("[data-tab-trigger]");
      var panels = document.querySelectorAll("[data-tab-panel]");
      function show(name) {
        tabs.forEach(function (b) {
          var on = b.getAttribute("data-tab-trigger") === name;
          b.setAttribute("aria-selected", on ? "true" : "false");
          // Toggle Tailwind utility classes simply (consistent with server render)
          if (on) {
            b.className = b.className.replace(/text-muted-foreground hover:bg-accent hover:text-foreground/g, "bg-primary/10 text-primary");
            b.className = b.className.replace(/\s+/g, " ").trim();
          } else {
            b.className = b.className.replace(/bg-primary\/10 text-primary/g, "text-muted-foreground hover:bg-accent hover:text-foreground");
            b.className = b.className.replace(/\s+/g, " ").trim();
          }
        });
        panels.forEach(function (p) {
          var on = p.getAttribute("data-tab-panel") === name;
          if (on) p.removeAttribute("hidden");
          else p.setAttribute("hidden", "");
        });
        // Update URL (replaceState so we don't pollute history)
        try {
          var url = new URL(location.href);
          if (name === "overview") url.searchParams.delete("tab");
          else url.searchParams.set("tab", name);
          url.hash = name === "audit" ? "#audit" : "";
          history.replaceState({}, "", url.toString());
        } catch (e) {}
        // Notify AuditPanel to re-wire its Run-audit button (in case we just swapped in fresh HTML)
        try {
          var freshBtn = document.querySelector("#audit-panel [data-audit-run]");
          if (freshBtn && !freshBtn.__wired) {
            freshBtn.__wired = true;
            freshBtn.addEventListener("click", function () {
              var leadId = document.getElementById("audit-panel").getAttribute("data-lead-id");
              if (typeof window.__auditRunHandler === "function") {
                window.__auditRunHandler(leadId);
              } else {
                // Defer: the AuditPanel's inline script will register it soon.
                setTimeout(function () {
                  if (typeof window.__auditRunHandler === "function") {
                    window.__auditRunHandler(leadId);
                  }
                }, 60);
              }
            });
          }
        } catch (e) {}
      }
      tabs.forEach(function (b) {
        b.addEventListener("click", function () {
          show(b.getAttribute("data-tab-trigger"));
        });
      });
      // Initial hash handling
      if (location.hash === "#audit") show("audit");
      // Expose to in-page AuditPanel so its run button works after re-render
      window.__switchTab = show;
    })();
  })();
</script>
