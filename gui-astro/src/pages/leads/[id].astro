---
import AppLayout from "../../layouts/AppLayout.astro";
import Card from "../../components/Card.astro";
import CardContent from "../../components/CardContent.astro";
import CardHeader from "../../components/CardHeader.astro";
import CardTitle from "../../components/CardTitle.astro";
import CardDescription from "../../components/CardDescription.astro";
import EditableField from "../../components/EditableField.astro";
import AuditPanel from "../../components/AuditPanel.astro";
import { getDb, schema } from "../../lib/db";
import { eq, desc } from "drizzle-orm";
import { formatDate, timeAgo } from "../../lib/utils";
import { getLatestAuditForLead, getAuditMetrics } from "../../lib/siteAudit";

const id = Number(Astro.params.id);
const db = getDb();
const url = Astro.url;

const [row] = db
  .select({
    lead: schema.leads,
    statusName: schema.statuses.name,
    statusColor: schema.statuses.color,
    campaignName: schema.campaigns.name,
  })
  .from(schema.leads)
  .leftJoin(schema.statuses, eq(schema.statuses.id, schema.leads.statusId))
  .leftJoin(schema.campaigns, eq(schema.campaigns.id, schema.leads.campaignId))
  .where(eq(schema.leads.id, id))
  .all();

if (!row) return new Response(null, { status: 404 });

const comments = db
  .select()
  .from(schema.comments)
  .where(eq(schema.comments.leadId, id))
  .orderBy(desc(schema.comments.createdAt))
  .all();
const scrapes = db.select().from(schema.siteScrapes).where(eq(schema.siteScrapes.leadId, id)).all();
const screenshots = db.select().from(schema.screenshots).where(eq(schema.screenshots.leadId, id)).all();
const emailSends = db
  .select()
  .from(schema.emailSends)
  .where(eq(schema.emailSends.leadId, id))
  .orderBy(desc(schema.emailSends.queuedAt))
  .all();
const statuses = db.select().from(schema.statuses).orderBy(schema.statuses.sortOrder).all();
const blocked = db.select().from(schema.blocklist).where(eq(schema.blocklist.leadId, id)).all().length > 0;
const lead = row.lead;

// Site audit (multi-criteria 0-100 ranking produced by scraper/audit/)
const auditReport = getLatestAuditForLead(id);
const auditMetrics = auditReport ? getAuditMetrics(auditReport.id) : [];

// Google search URL
const searchQ = [lead.name, lead.city].filter(Boolean).join(" ");
const googleSearchUrl = `https://www.google.com/search?q=${encodeURIComponent(searchQ)}`;

const ok = url.searchParams.get("ok");
const error = url.searchParams.get("error");

// Active tab — supports ?tab=audit query and #audit hash
const requestedTab = url.searchParams.get("tab") ?? (url.hash === "#audit" ? "audit" : "overview");
const activeTab: "overview" | "audit" = requestedTab === "audit" ? "audit" : "overview";
---
<AppLayout title={`${lead.name} — Outreach`}>
  <div>
    <!-- Header -->
    <div class="border-b border-slate-200 bg-white px-6 py-4">
      <div class="flex items-center justify-between gap-3">
        <a href="/leads" class="text-xs text-muted-foreground hover:underline">← Leadovi</a>
        <div class="flex items-center gap-2">
          {blocked && (
            <span class="inline-flex items-center rounded-full bg-red-100 px-3 py-1 text-xs font-medium text-red-700 dark:bg-red-950/40 dark:text-red-300">Blokiran</span>
          )}
        </div>
      </div>
      <div class="mt-1 flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
          <h1 class="text-2xl font-bold tracking-tight text-foreground">
            <a
              href={googleSearchUrl}
              target="_blank"
              rel="noopener"
              class="hover:text-primary hover:underline"
              title={`Google pretraga za "${searchQ}"`}
            >
              {lead.name}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ml-1 inline -translate-y-0.5 text-muted-foreground hover:text-primary"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
            </a>
          </h1>
          {(lead.category || lead.city) && (
            <span class="mt-1 inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/40 px-2.5 py-0.5 text-xs font-medium text-foreground/80">
              {lead.category && <span class="text-foreground/90">{lead.category}</span>}
              {lead.category && lead.city && <span class="text-muted-foreground">—</span>}
              {lead.city && <span class="text-foreground/90">{lead.city}</span>}
            </span>
          )}
          <p class="mt-1.5 text-sm text-muted-foreground">
            {row.campaignName ? (
              <a href={`/campaigns/${lead.campaignId}`} class="hover:underline">{row.campaignName}</a>
            ) : "Bez kampanje"}
            {lead.address ? ` · ${lead.address}` : ""}
          </p>
        </div>
        <!-- Status select + danger actions (desno, automatski čuva) -->
        <div class="flex shrink-0 items-center gap-2">
          <label for="header-status-select" class="text-xs font-medium text-muted-foreground">Status:</label>
          <select
            id="header-status-select"
            data-initial-status={lead.statusId != null ? String(lead.statusId) : ""}
            class="h-9 rounded-md border border-input bg-background px-3 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:border-primary"
            style={lead.statusName ? `color:${row.statusColor}` : undefined}
          >
            <option value="__add__" class="text-foreground/80">+ Dodaj novi status</option>
            {statuses.map((s) => (
              <option value={String(s.id)} selected={s.id === lead.statusId} style={`color:${s.color}`}>{s.name}</option>
            ))}
            <option value="__none__" selected={lead.statusId === null}>Bez statusa</option>
          </select>

          {/* Opasne akcije — dropdown sa potvrdom */}
          {/* z-50 stavlja panel IZNAD sticky tab nav-a (koji je z-30) i IZNAD scrape progress-a (z-40). */}
          <details class="group relative">
            <summary
              class="inline-flex h-9 cursor-pointer list-none items-center justify-center gap-1 rounded-md border border-destructive/30 bg-destructive-soft px-2.5 text-sm font-medium text-destructive transition-colors hover:bg-destructive/10 group-open:bg-destructive/10"
              title="Opasne akcije"
              aria-label="Opasne akcije"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
              <svg class="h-2.5 w-2.5 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div
              class="absolute right-0 top-11 z-50 w-56 origin-top-right rounded-lg border border-destructive/30 bg-card p-4 shadow-2xl ring-1 ring-black/5"
              role="dialog"
              aria-label="Opasne akcije"
            >
              <div class="mb-3 flex items-start gap-2">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-destructive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
                <div>
                  <p class="text-sm font-semibold text-foreground">Obriši ovog leada?</p>
                  <p class="mt-0.5 text-xs text-muted-foreground">Briše i sve komentare, screenshot-ove, emailove i audit.</p>
                </div>
              </div>
              <form
                method="POST"
                action={`/leads/${id}/delete`}
                onsubmit="return confirm('TRAJNO obrisati ovog leada i sve njegove komentare, screenshot-ove, emailove?') || event.preventDefault()"
              >
                <button type="submit" class="inline-flex h-9 w-full items-center justify-center gap-1.5 rounded-md bg-destructive text-sm font-medium text-destructive-foreground shadow-sm transition-all hover:brightness-110 active:scale-[0.985]">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                  Da, obriši
                </button>
              </form>
            </div>
          </details>
        </div>
      </div>
    </div>

    {/* TAB nav + action buttons row — sticky under header */}
    <div class="sticky top-0 z-30 -mt-px border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
      <div class="flex h-11 items-center gap-1 px-6">
        {/* Tabs (left) */}
        <nav class="flex items-center gap-1" role="tablist" aria-label="Lead tabs">
          <button
            type="button"
            data-tab-trigger="overview"
            role="tab"
            aria-selected={activeTab === "overview"}
            class={`inline-flex h-9 items-center gap-2 rounded-md px-3 text-sm font-medium transition-colors ${activeTab === "overview" ? "bg-primary/10 text-primary" : "text-muted-foreground hover:bg-accent hover:text-foreground"}`}
          >
            Overview
          </button>
          <button
            type="button"
            data-tab-trigger="audit"
            role="tab"
            aria-selected={activeTab === "audit"}
            class={`inline-flex h-9 items-center gap-2 rounded-md px-3 text-sm font-medium transition-colors ${activeTab === "audit" ? "bg-primary/10 text-primary" : "text-muted-foreground hover:bg-accent hover:text-foreground"}`}
          >
            Site Audit
            {auditReport && (
              <span
                class={`inline-flex h-5 min-w-[28px] items-center justify-center rounded-md px-1.5 text-[11px] font-semibold tabular-nums ${
                  auditReport.overallRank >= 86 ? "bg-emerald-100 text-emerald-700" :
                  auditReport.overallRank >= 71 ? "bg-emerald-50 text-emerald-700" :
                  auditReport.overallRank >= 56 ? "bg-amber-100 text-amber-700" :
                  auditReport.overallRank >= 31 ? "bg-orange-100 text-orange-700" :
                  "bg-red-100 text-red-700"
                }`}
                title={`Latest audit: ${auditReport.overallRank}/100`}
              >
                {auditReport.overallRank}
              </span>
            )}
          </button>
        </nav>

        {/* Action buttons (right) — single row, icon-only */}
        <div class="ml-auto flex items-center gap-1.5">
          {/* Blokiraj / Odblokiraj */}
          {!blocked ? (
            <form method="POST" action={`/leads/${id}/block`} class="contents">
              <button type="submit" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-destructive/30 bg-destructive-soft text-destructive transition-colors hover:bg-destructive/10" title="Blokiraj (do_not_contact)" aria-label="Blokiraj">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="4.93" x2="19.07" y1="4.93" y2="19.07"/></svg>
              </button>
            </form>
          ) : (
            <form method="POST" action={`/leads/${id}/unblock`} class="contents">
              <button type="submit" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-success/30 bg-success-soft text-success transition-colors hover:bg-success/10" title="Odblokiraj" aria-label="Odblokiraj">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
            </form>
          )}

          {lead.websiteNormalized && (
            <a
              href={`https://${lead.websiteNormalized}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-9 w-9 items-center justify-center rounded-md bg-primary text-primary-foreground shadow-sm transition-all hover:brightness-110 active:scale-[0.985]"
              title="Idi na sajt"
              aria-label="Idi na sajt"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
            </a>
          )}

          {lead.websiteNormalized && (
            <button
              type="button"
              id="start-site-scrape"
              data-lead-id={id}
              data-website={lead.websiteNormalized}
              class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-input bg-background transition-colors hover:bg-accent disabled:opacity-50"
              title="Pokreni scrape sajta"
              aria-label="Pokreni scrape sajta"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><polyline points="21 3 21 9 15 9"/></svg>
            </button>
          )}

          <a
            href={googleSearchUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-input bg-background transition-colors hover:bg-accent"
            title="Google pretraga"
            aria-label="Google pretraga"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" x2="16.65" y1="21" y2="16.65"/></svg>
          </a>

          <a
            href={`https://www.google.com/maps/search/${encodeURIComponent(searchQ)}`}
            target="_blank"
            rel="noopener"
            class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-input bg-background transition-colors hover:bg-accent"
            title="Google Maps"
            aria-label="Google Maps"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </a>
        </div>
      </div>

      {/* Scrape progress — čist full-width progress bar (bez teksta, bez labela). */}
      {/* Visok (h-3) da se vidi jasno; traka je ujedno i labela (boja se menja). */}
      {/* Skriveni spanovi #ssp-stage/#ssp-count/#ssp-msg ostaju u DOM-u da JS iz setProgress() ne pukne. */}
      <div
        id="site-scrape-progress"
        role="status"
        aria-live="polite"
        class="hidden w-full overflow-hidden border-t-2 border-primary/40 bg-muted/30"
      >
        <div class="relative h-3 w-full overflow-hidden bg-primary/10" title="Scrape u toku">
          <div id="ssp-bar" class="absolute inset-y-0 left-0 bg-gradient-to-r from-primary to-primary/70 transition-[width] duration-300 ease-out" style="width: 0%"></div>
        </div>
        {/* Skriveni nosači koje JS popunjava — nisu vidljivi u UI, samo da getElementById ne vrati null. */}
        <span id="ssp-stage" hidden></span>
        <span id="ssp-count" hidden></span>
        <span id="ssp-msg" hidden></span>
      </div>
    </div>

    {/* TAB: Overview (existing content) */}
    <div data-tab-panel="overview" hidden={activeTab !== "overview"}>
    <div class="space-y-6 p-6">
      {ok && <div class="rounded-md bg-green-50 px-3 py-2 text-sm text-green-700">{ok}</div>}
      {error && <div class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700">{error}</div>}

      <div class="grid gap-6 lg:grid-cols-3">
        <!-- LEFT column: Kontakt → Email → Screenshots -->
        <div class="lg:col-span-2 space-y-6">
          <!-- 1) KONTAKT — editable inputs, autosave on blur -->
          <Card>
            <CardHeader>
              <div class="flex items-center justify-between">
                <div>
                  <CardTitle class="text-base">Kontakt</CardTitle>
                  <CardDescription>Sva polja se automatski čuvaju kad klikneš van</CardDescription>
                </div>
                <span
                  id="contact-save-indicator"
                  data-state="idle"
                  class="inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/40 px-2.5 py-0.5 text-xs font-medium text-muted-foreground"
                  aria-live="polite"
                >
                  <span data-indicator-icon></span>
                  <span data-indicator-text>Idle</span>
                </span>
              </div>
            </CardHeader>
            <CardContent>
              <div class="grid grid-cols-1 gap-x-3 gap-y-3 md:grid-cols-2">
                <EditableField name="name" label="Naziv" value={lead.name} required />
                <EditableField name="category" label="Kategorija" value={lead.category} />
                <EditableField name="city" label="Grad" value={lead.city} required />
                <EditableField name="address" label="Adresa" value={lead.address} />
                <EditableField name="postalCode" label="Poštanski broj" value={lead.postalCode} />
                <EditableField name="phoneRaw" label="Telefon" value={lead.phoneRaw} type="tel" placeholder="064/123-4567" />
                <EditableField name="email" label="Email" value={lead.email} type="email" />
                <EditableField name="websiteRaw" label="Website" value={lead.websiteRaw} type="url" placeholder="example.rs" />
                <EditableField name="googleRating" label="Google ocena (1–5)" value={lead.googleRating} type="number" step="0.1" min="1" max="5" />
                <EditableField name="reviewsCount" label="Broj recenzija" value={lead.reviewsCount} type="number" min="0" />
                <EditableField name="source" label="Izvor" value={lead.source} placeholder="npr. manual, poznanstvo…" />
              </div>
            </CardContent>
          </Card>

          {/* 3) EMAIL historia */}
          {emailSends.length > 0 && (
            <Card>
              <CardHeader>
                <div class="flex items-center justify-between">
                  <CardTitle class="text-base">Email istorija ({emailSends.length})</CardTitle>
                  <details class="relative">
                    <summary class="cursor-pointer text-xs text-primary hover:underline">+ Novi email (ručno)</summary>
                    <form method="POST" action={`/leads/${id}/new-email`} class="absolute right-0 top-5 z-10 w-96 space-y-2 rounded-md border border-border bg-card p-3 shadow-lg">
                      <input name="subject" required placeholder="Subject" class="flex h-8 w-full rounded-md border border-input bg-background px-2 text-sm" />
                      <textarea name="body" required rows="5" placeholder="Telo emaila…" class="flex w-full rounded-md border border-input bg-background px-2 py-1 text-xs"></textarea>
                      <button type="submit" class="inline-flex h-8 w-full items-center justify-center rounded-md bg-primary px-3 text-xs font-medium text-primary-foreground hover:opacity-90">Sačuvaj draft</button>
                    </form>
                  </details>
                </div>
              </CardHeader>
              <CardContent>
                <div class="divide-y divide-border">
                  {emailSends.map((e) => (
                    <div class="py-3">
                      <div class="flex items-center justify-between gap-2">
                        <div class="flex-1 min-w-0">
                          <div class="font-medium text-sm">{e.subject || "(bez subject-a)"}</div>
                          <div class="text-xs text-muted-foreground">
                            {e.status} · {e.replied && "✓ reply"} · {e.generatedByAi ? "AI" : "ručno"}
                          </div>
                        </div>
                        <div class="text-xs text-muted-foreground">{formatDate(e.queuedAt ?? e.sentAt ?? null)}</div>
                      </div>
                      {e.body && (
                        <details class="mt-2">
                          <summary class="cursor-pointer text-xs text-primary">Prikaži telo</summary>
                          <pre class="mt-2 whitespace-pre-wrap rounded-md bg-muted/40 p-2 text-xs">{e.body}</pre>
                        </details>
                      )}
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>
          )}

          {/* 4) SCREENSHOTS */}
          {screenshots.length > 0 && (
            <Card>
              <CardHeader>
                <CardTitle class="text-base">Screenshots ({screenshots.length})</CardTitle>
                <CardDescription>Klikni sliku za fullscreen</CardDescription>
              </CardHeader>
              <CardContent class="space-y-2">
                {screenshots.map((s) => (
                  <button
                    type="button"
                    class="screenshot-thumb group block w-full overflow-hidden rounded-md border border-border bg-muted/40 transition hover:border-primary"
                    data-src={`/api/screenshot/${lead.id}?v=${s.id}`}
                    data-caption={`${lead.name} — ${formatDate(s.capturedAt)}`}
                  >
                    <img src={`/api/screenshot/${lead.id}?v=${s.id}`} alt="screenshot" loading="lazy" class="block w-full transition group-hover:opacity-90" />
                  </button>
                ))}
              </CardContent>
            </Card>
          )}
        </div>

        <!-- RIGHT column: Komentari → Detalji -->
        <div class="space-y-6">
          {/* Komentari */}
          <Card>
            <CardHeader>
              <CardTitle class="text-base">Komentari ({comments.length})</CardTitle>
              <CardDescription>Interne beleške — ne idu u email</CardDescription>
            </CardHeader>
            <CardContent>
              <form method="POST" action={`/leads/${id}/comment`} class="mb-4 space-y-2">
                <textarea
                  name="body"
                  required
                  rows="3"
                  placeholder="Npr. 'Razgovarali smo u sredu, zainteresovan za uslugu, treba poslati ponudu'"
                  class="flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:border-primary"
                ></textarea>
                <div class="flex justify-end">
                  <button
                    type="submit"
                    class="inline-flex h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm transition-all hover:brightness-110 active:scale-[0.985]"
                  >
                    + Dodaj komentar
                  </button>
                </div>
              </form>

              {comments.length === 0 ? (
                <p class="py-3 text-center text-sm text-muted-foreground">Nema komentara. Dodaj prvi iznad.</p>
              ) : (
                <ul class="max-h-[60vh] space-y-2 overflow-y-auto pr-1">
                  {comments.map((c) => (
                    <li class="rounded-md bg-muted/40 p-3 text-sm">
                      <div class="whitespace-pre-wrap">{c.body}</div>
                      <div class="mt-1 text-xs text-muted-foreground">{timeAgo(c.createdAt)} · {formatDate(c.createdAt)}</div>
                    </li>
                  ))}
                </ul>
              )}
            </CardContent>
          </Card>

          {/* Detalji (uključuje scrape runove ako ih ima) */}
          <Card>
            <CardHeader>
              <CardTitle class="text-base">Detalji</CardTitle>
            </CardHeader>
            <CardContent class="space-y-1 text-xs text-muted-foreground">
              <div>ID: {lead.id}</div>
              <div>Kreiran: {formatDate(lead.createdAt)}</div>
              <div>Ažuriran: {formatDate(lead.updatedAt)}</div>
              {lead.sourceUrl && (
                <div>
                  <a href={lead.sourceUrl} target="_blank" class="text-primary hover:underline">Izvor ↗</a>
                </div>
              )}
              {scrapes.length > 0 && (
                <div class="pt-2">
                  <div class="font-medium text-foreground">Scrape runovi</div>
                  {scrapes.map((s) => (
                    <div class="mt-1 rounded-md bg-muted/40 p-2">
                      <div class="font-medium">{s.status}</div>
                      <div class="text-xs">{s.pagesScraped}/{s.totalPagesDiscovered} strana · {formatDate(s.startedAt)}</div>
                    </div>
                  ))}
                </div>
              )}
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
    </div>
    {/* /TAB: Overview */}

    {/* TAB: Audit */}
    <div data-tab-panel="audit" hidden={activeTab !== "audit"}>
      <div class="space-y-6 p-6">
        <AuditPanel
          lead={{
            id: lead.id,
            name: lead.name,
            websiteNormalized: lead.websiteNormalized,
          }}
          report={auditReport as any}
          metrics={auditMetrics as any}
          hasScrape={scrapes.length > 0}
        />
      </div>
    </div>
  </div>
</AppLayout>

