---
import AppLayout from "../layouts/AppLayout.astro";
import Card from "../components/Card.astro";
import { listAudit } from "../lib/audit";
import { formatDate, timeAgo } from "../lib/utils";

const items = listAudit({ limit: 200 });
---
<AppLayout title="Audit — Outreach">
  <div>
    <div class="border-b px-6 py-4">
      <h1 class="text-xl font-bold tracking-tight">Audit log</h1>
      <p class="text-sm text-muted-foreground">{items.length} poslednjih događaja</p>
    </div>

    <div class="p-6">
      <Card>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="border-b bg-muted/40 text-left text-xs uppercase text-muted-foreground">
              <tr>
                <th class="px-4 py-2">Vreme</th>
                <th class="px-4 py-2">Akcija</th>
                <th class="px-4 py-2">Entitet</th>
                <th class="px-4 py-2">Meta</th>
              </tr>
            </thead>
            <tbody class="divide-y">
              {items.length === 0 ? (
                <tr><td colspan="4" class="px-4 py-8 text-center text-muted-foreground">Nema događaja.</td></tr>
              ) : items.map((it) => (
                <tr>
                  <td class="px-4 py-2 text-xs">
                    <div>{formatDate(it.ts)}</div>
                    <div class="text-muted-foreground">{timeAgo(it.ts)}</div>
                  </td>
                  <td class="px-4 py-2 font-mono text-xs">{it.action}</td>
                  <td class="px-4 py-2 text-xs">
                    {it.entity}{it.entity_id && `#${it.entity_id}`}
                  </td>
                  <td class="px-4 py-2 font-mono text-xs text-muted-foreground">
                    {it.meta ? JSON.stringify(it.meta) : "—"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    </div>
  </div>
</AppLayout>
