---
/**
 * ThemeToggle — jednostavno 2-stanje (light/dark) dugme.
 *
 * <ThemeToggle />                    — kompaktan, 32x32 ikona (toolbar, header)
 * <ThemeToggle expanded />           — full width sa labelom (sidebar)
 * <ThemeToggle compact />            — 44x44 touch-friendly (mobile top bar)
 *
 * Čuva izbor u localStorage["app_theme"] = "light" | "dark".
 * Toggle-uje `dark` klasu na <html>.
 * AppLayout pre-paint skripta čita isti ključ da izbegne FOUC.
 *
 * NOTE: skripta je idempotentna i podržava više instanci na stranici
 * (npr. jedan u Sidebar-u, jedan u MobileTopBar-u) — selektuje sve
 * elemente sa `data-theme-toggle` atributom.
 */
interface Props {
  class?: string;
  expanded?: boolean; // sidebar mod: full width + labela
  compact?: boolean;  // mobilni mod: 44x44 touch-friendly ikona
  id?: string;
}
const { class: cls = "", expanded = false, compact = false, id } = Astro.props;

const sizeClass = expanded
  ? "flex h-9 w-full items-center gap-3 rounded-md px-2.5 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
  : compact
    ? "relative inline-flex h-11 w-11 items-center justify-center overflow-hidden rounded-md text-muted-foreground transition-all duration-200 hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40"
    : "relative inline-flex h-8 w-8 items-center justify-center overflow-hidden rounded-md text-muted-foreground transition-all duration-200 hover:bg-accent hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40";
---
<button
  type="button"
  data-theme-toggle
  {id}
  aria-label="Prebaci temu"
  title="Prebaci tamnu/svetlu temu"
  data-expanded={expanded ? "true" : "false"}
  class:list={[sizeClass, cls]}
>
  <!-- Sun ikona (vidljiva u light mode) -->
  <svg
    class="theme-icon-sun shrink-0 transition-all duration-300"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <!-- Moon ikona (vidljiva u dark mode) -->
  <svg
    class="theme-icon-moon shrink-0 rotate-90 scale-50 opacity-0 transition-all duration-300"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>

  {expanded ? (
    <>
      <span class="sidebar-label flex-1 truncate text-left" data-theme-label>Tema</span>
      <span class="sidebar-label text-[10px] text-muted-foreground" data-theme-mode>svetla</span>
    </>
  ) : null}
</button>

<script is:inline>
  // Theme toggle — radi sa SVIM elementima koji imaju [data-theme-toggle].
  // Idempotentan (označava instance sa data-theme-bound flag-om).
  (function () {
    var STORAGE_KEY = "app_theme";

    function readTheme() {
      try {
        var v = localStorage.getItem(STORAGE_KEY);
        return v === "dark" || v === "light" ? v : "light";
      } catch (e) {
        return "light";
      }
    }

    function applyThemeToButton(btn, isDark) {
      var sun = btn.querySelector(".theme-icon-sun");
      var moon = btn.querySelector(".theme-icon-moon");
      if (sun && moon) {
        if (isDark) {
          sun.classList.add("rotate-90", "scale-50", "opacity-0");
          moon.classList.remove("rotate-90", "scale-50", "opacity-0");
        } else {
          sun.classList.remove("rotate-90", "scale-50", "opacity-0");
          moon.classList.add("rotate-90", "scale-50", "opacity-0");
        }
      }
      btn.setAttribute("aria-pressed", isDark ? "true" : "false");
      btn.title = isDark ? "Prebaci na svetlu temu" : "Prebaci na tamnu temu";
      var mode = btn.querySelector("[data-theme-mode]");
      if (mode) mode.textContent = isDark ? "tamna" : "svetla";
    }

    function applyTheme(theme) {
      var root = document.documentElement;
      var isDark = theme === "dark";
      if (isDark) root.classList.add("dark");
      else root.classList.remove("dark");
      try { root.style.colorScheme = isDark ? "dark" : "light"; } catch (e) {}
      // Sinhronizuj SVAKU instancu
      var btns = document.querySelectorAll("[data-theme-toggle]");
      for (var i = 0; i < btns.length; i++) {
        applyThemeToButton(btns[i], isDark);
      }
    }

    // Init (pre-paint skripta u AppLayout je već postavila klasu, ali sinhronizujemo ikonice)
    applyTheme(readTheme());

    // Bind click handler na svaku instancu
    var btns = document.querySelectorAll("[data-theme-toggle]");
    for (var i = 0; i < btns.length; i++) {
      (function (btn) {
        if (btn.dataset.themeBound) return;
        btn.dataset.themeBound = "1";
        btn.addEventListener("click", function () {
          var next = readTheme() === "dark" ? "light" : "dark";
          try { localStorage.setItem(STORAGE_KEY, next); } catch (e) {}
          applyTheme(next);
        });
      })(btns[i]);
    }

    // Cross-tab sync
    window.addEventListener("storage", function (e) {
      if (e.key !== STORAGE_KEY) return;
      applyTheme(readTheme());
    });
  })();
</script>
