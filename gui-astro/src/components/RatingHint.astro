---
/**
 * RatingHint — Google Maps star rating with color tier + progress bar.
 *
 * <RatingHint rating={4.7} reviewsCount={120} />  → green 4.7★ (120)
 * <RatingHint rating={3.2} />                    → amber 3.2★
 */
import Icon from "./Icon.astro";
import { formatNumber } from "~/lib/utils";

interface Props {
  rating: number | null | undefined;
  reviewsCount?: number | null | undefined;
  showBar?: boolean;
  size?: "sm" | "md";
  class?: string;
}

const { rating, reviewsCount, showBar = false, size = "md", class: cls = "" } = Astro.props;

function hint(r: number) {
  if (r >= 4.5) return { color: "text-emerald-500", bg: "bg-emerald-500" };
  if (r >= 4.0) return { color: "text-lime-500", bg: "bg-lime-500" };
  if (r >= 3.0) return { color: "text-amber-500", bg: "bg-amber-500" };
  return { color: "text-red-500", bg: "bg-red-500" };
}

const h = rating != null ? hint(rating) : null;
const pct = rating != null ? Math.max(0, Math.min(100, (rating / 5) * 100)) : 0;
const starSize = size === "sm" ? 12 : 14;
const ratingSize = size === "sm" ? "text-xs font-semibold" : "text-sm font-semibold";
---
<div class={`flex items-center gap-2 ${cls}`}>
  {rating != null && h ? (
    <>
      <div class="flex items-center gap-0.5">
        <Icon name="star" size={starSize} class={h.color} strokeWidth={2.5} aria-label="rating" />
        <span class={`tabular-nums text-foreground ${ratingSize}`}>{rating.toFixed(1)}</span>
      </div>
      {reviewsCount != null && (
        <span class="text-xs text-muted-foreground" title={`${reviewsCount} recenzija`}>
          ({formatNumber(reviewsCount)})
        </span>
      )}
      {showBar && (
        <div class="ml-1 h-1.5 w-12 overflow-hidden rounded-full bg-muted">
          <div class={`h-full rounded-full ${h.bg}`} style={`width:${pct}%`}></div>
        </div>
      )}
    </>
  ) : (
    <span class="text-muted-foreground/40">—</span>
  )}
</div>
