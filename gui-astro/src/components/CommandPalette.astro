---
/**
 * CommandPalette — quick navigation modal (⌘K / Ctrl-K).
 *
 * Lists static app pages + accepts lead/campaign jump-to-id input.
 * Fully client-side (inline script), no network round-trip.
 */
import Icon from "./Icon.astro";
import { ICONS } from "~/lib/icons";

interface NavItem {
  label: string;
  href: string;
  icon: string; // IconName
  group: string;
}

const NAV: NavItem[] = [
  { label: "Dashboard", href: "/", icon: "layout-dashboard", group: "Navigacija" },
  { label: "Kampanje", href: "/campaigns", icon: "users", group: "Navigacija" },
  { label: "Dodaj klijenta", href: "/leads?action=new", icon: "user-plus", group: "Akcije", hint: "Otvara modal na /leads" },
  { label: "Import u kampanju", href: "/campaigns", icon: "upload", group: "Akcije", hint: "Otvara import modal na /campaigns" },
  { label: "Šabloni", href: "/templates", icon: "file-text", group: "Navigacija" },
  { label: "Senderi", href: "/senders", icon: "send", group: "Navigacija" },
  { label: "Red slanja", href: "/queue", icon: "list-checks", group: "Navigacija" },
  { label: "Inbox", href: "/inbox", icon: "inbox", group: "Navigacija" },
  { label: "Statusi", href: "/statuses", icon: "tag", group: "Navigacija" },
  { label: "Podešavanja", href: "/settings", icon: "settings", group: "Navigacija" },
  { label: "Audit log", href: "/audit", icon: "activity", group: "Navigacija" },
];

// Subset of icons used by NAV (so the inline script doesn't need the full library)
const ICON_PATHS: Record<string, string> = {
  "layout-dashboard": ICONS["layout-dashboard"],
  "users": ICONS["users"],
  "user-plus": ICONS["user-plus"],
  "upload": ICONS["upload"],
  "file-text": ICONS["file-text"],
  "send": ICONS["send"],
  "list-checks": ICONS["list-checks"],
  "inbox": ICONS["inbox"],
  "tag": ICONS["tag"],
  "settings": ICONS["settings"],
  "activity": ICONS["activity"],
  "user": ICONS["user"],
};
---
<dialog
  id="command-palette"
  aria-label="Brza navigacija"
  class="modal-dialog border-0 bg-transparent p-0 backdrop:bg-black/40 backdrop:backdrop-blur-sm"
  style="--modal-max-w: 672px"
>
  <div class="flex max-h-[70vh] flex-col overflow-hidden rounded-xl border border-border bg-popover shadow-2xl">
    <div class="flex items-center gap-2 border-b border-border px-4 py-3">
      <Icon name="search" size={16} class="text-muted-foreground" />
      <input
        id="cp-input"
        type="search"
        placeholder="Traži stranu, ili ukucaj #123 za lead…"
        class="flex h-9 w-full border-0 bg-transparent text-sm placeholder:text-muted-foreground focus:outline-none"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="hidden rounded border border-border bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground sm:inline-block">ESC</kbd>
    </div>
    <ul id="cp-results" class="max-h-[50vh] overflow-y-auto p-1.5" role="listbox">
      {/* Populated by JS */}
    </ul>
    <div class="border-t border-border bg-muted/30 px-4 py-2 text-[11px] text-muted-foreground">
      <span class="font-semibold text-foreground">Tip:</span> ukucaj
      <code class="rounded bg-background px-1 py-0.5 font-mono">/lead 123</code>
      ili
      <code class="rounded bg-background px-1 py-0.5 font-mono">/camp 5</code>
      za direktan skok.
    </div>
  </div>
</dialog>

<script is:inline define:vars={{ NAV, ICON_PATHS }}>
  (function () {
    var dlg = document.getElementById("command-palette");
    var input = document.getElementById("cp-input");
    var list = document.getElementById("cp-results");
    if (!dlg || !input || !list) return;

    var activeIdx = 0;

    function render(items) {
      list.innerHTML = "";
      if (items.length === 0) {
        var empty = document.createElement("li");
        empty.className = "px-3 py-4 text-center text-sm text-muted-foreground";
        empty.textContent = "Nema rezultata.";
        list.appendChild(empty);
        return;
      }
      // Group by `group`
      var byGroup = {};
      items.forEach(function (it, idx) {
        if (!byGroup[it.group]) byGroup[it.group] = [];
        byGroup[it.group].push({ item: it, idx: idx });
      });
      Object.keys(byGroup).forEach(function (groupKey) {
        var groupLi = document.createElement("li");
        groupLi.className = "px-2 pt-2 pb-1 text-[10px] font-semibold uppercase tracking-wider text-muted-foreground";
        groupLi.textContent = groupKey;
        list.appendChild(groupLi);
        byGroup[groupKey].forEach(function (entry) {
          var it = entry.item;
          var realIdx = entry.idx;
          var li = document.createElement("li");
          li.className = "flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors hover:bg-accent";
          li.setAttribute("role", "option");
          li.setAttribute("data-idx", String(realIdx));
          li.innerHTML =
            '<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-muted text-muted-foreground">' +
              '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
                (ICON_PATHS[it.icon] || "") +
              '</svg>' +
            '</span>' +
            '<span class="flex-1 truncate font-medium text-foreground">' + escapeHtml(it.label) + '</span>' +
            '<span class="text-xs text-muted-foreground">' + escapeHtml(it.hint || it.href) + '</span>';
          li.addEventListener("click", function () { window.location.href = it.href; });
          list.appendChild(li);
        });
      });
      highlight(activeIdx);
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#39;" }[c];
      });
    }

    function highlight(idx) {
      var items = list.querySelectorAll("li[role='option']");
      items.forEach(function (li) { li.classList.remove("bg-accent", "text-accent-foreground"); });
      var t = list.querySelector("li[data-idx='" + idx + "']");
      if (t) {
        t.classList.add("bg-accent", "text-accent-foreground");
        t.scrollIntoView({ block: "nearest" });
      }
    }

    function computeMatches(q) {
      q = (q || "").trim().toLowerCase();
      // Special commands: /lead N | /camp N | /p path
      if (q.startsWith("/lead ") || q.startsWith("/l ")) {
        var n = q.replace(/^\/lead\s+|^l\s+/, "").replace(/\D/g, "");
        if (n) return [{ label: "Otvori lead #" + n, href: "/leads/" + n, icon: "user", group: "Skok", hint: "ID " + n }];
      }
      if (q.startsWith("/camp ") || q.startsWith("/c ")) {
        var n = q.replace(/^\/camp\s+|^c\s+/, "").replace(/\D/g, "");
        if (n) return [{ label: "Otvori kampanju #" + n, href: "/campaigns/" + n, icon: "users", group: "Skok", hint: "ID " + n }];
      }
      if (q.startsWith("/queue ")) {
        var st = q.replace(/^\/queue\s+/, "");
        return [{ label: "Queue → " + st, href: "/queue?status=" + encodeURIComponent(st), icon: "list-checks", group: "Skok", hint: st }];
      }
      if (!q) return NAV.map(function (n) { return Object.assign({}, n, { hint: n.href }); });
      return NAV
        .map(function (n) { return Object.assign({}, n, { hint: n.href }); })
        .filter(function (n) { return n.label.toLowerCase().indexOf(q) >= 0; });
    }

    input.addEventListener("input", function () {
      activeIdx = 0;
      var matches = computeMatches(input.value);
      render(matches);
    });

    input.addEventListener("keydown", function (e) {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        var items = list.querySelectorAll("li[role='option']");
        if (items.length === 0) return;
        activeIdx = (activeIdx + 1) % items.length;
        highlight(activeIdx);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        var items = list.querySelectorAll("li[role='option']");
        if (items.length === 0) return;
        activeIdx = (activeIdx - 1 + items.length) % items.length;
        highlight(activeIdx);
      } else if (e.key === "Enter") {
        e.preventDefault();
        var target = list.querySelector("li[data-idx='" + activeIdx + "']");
        if (target) target.click();
      } else if (e.key === "Escape") {
        e.preventDefault();
        close();
      }
    });

    // dlg click on backdrop closes
    dlg.addEventListener("click", function (e) {
      if (e.target === dlg) close();
    });

    function open() {
      if (typeof dlg.showModal !== "function") return;
      dlg.showModal();
      input.value = "";
      activeIdx = 0;
      render(NAV.map(function (n) { return Object.assign({}, n, { hint: n.href }); }));
      setTimeout(function () { input.focus(); }, 30);
    }
    function close() { if (dlg.open) dlg.close(); }

    window.__openCommandPalette = open;

    // Global hotkey (⌘K on Mac, Ctrl-K elsewhere)
    document.addEventListener("keydown", function (e) {
      var isK = (e.key === "k" || e.key === "K");
      if (isK && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        if (dlg.open) close(); else open();
      }
      // Also ⌘/ / to focus palette input even when closed (useful on dashboard)
      var isSlash = (e.key === "/" && (e.metaKey || e.ctrlKey));
      if (isSlash) {
        e.preventDefault();
        open();
      }
    });
  })();
</script>
