---
/**
 * Banner — inline alert/notification bar.
 * Replaces ad-hoc `bg-green-50 px-3 py-2 text-sm text-green-700` blocks everywhere.
 *
 * <Banner kind="success" message="Sačuvano" />
 * <Banner kind="error" message={url.searchParams.get("error")} />
 */
import Icon from "./Icon.astro";
import type { IconName } from "~/lib/icons";

interface Props {
  kind?: "success" | "error" | "warning" | "info";
  message: string;
  icon?: IconName;
  dismissible?: boolean;
  class?: string;
}

const { kind = "info", message, icon, dismissible, class: cls = "" } = Astro.props;

const META: Record<NonNullable<Props["kind"]>, { cls: string; icon: IconName }> = {
  success: {
    cls: "bg-success-soft text-success border-success/30",
    icon: "check-circle",
  },
  error: {
    cls: "bg-destructive-soft text-destructive border-destructive/30",
    icon: "alert-triangle",
  },
  warning: {
    cls: "bg-warning-soft text-warning border-warning/30",
    icon: "alert-triangle",
  },
  info: {
    cls: "bg-info-soft text-info border-info/30",
    icon: "info",
  },
};

const m = META[kind];
---
<div
  class={`flex items-start gap-2 rounded-md border px-3 py-2 text-sm ${m.cls} ${cls}`}
  data-banner
  data-kind={kind}
  role={kind === "error" ? "alert" : "status"}
>
  <Icon name={icon ?? m.icon} size={16} class="mt-0.5 shrink-0" />
  <span class="flex-1 break-words">{message}</span>
  {dismissible && (
    <button
      type="button"
      class="shrink-0 opacity-70 transition-opacity hover:opacity-100"
      data-banner-close
      aria-label="Zatvori"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
      </svg>
    </button>
  )}
</div>

<script is:inline>
  document.querySelectorAll("[data-banner-close]").forEach((btn) => {
    btn.addEventListener("click", () => btn.closest("[data-banner]")?.remove());
  });
</script>
