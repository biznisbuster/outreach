---
/**
 * KpiCard — dashboard metric tile.
 *
 * <KpiCard label="Leadovi" value={42} hint="3 kampanje" icon="users" tone="primary" />
 *
 * Vertical-stacked layout: label on top, value mid (large), hint at bottom. Icon sits
 * in the top-right corner. Tight padding so the card feels filled.
 */
import Icon from "./Icon.astro";
import type { IconName } from "~/lib/icons";

interface Props {
  label: string;
  value: string | number;
  hint?: string;
  icon?: IconName;
  tone?: "primary" | "success" | "warning" | "info" | "muted";
  href?: string;
  class?: string;
}

const {
  label,
  value,
  hint,
  icon,
  tone = "primary",
  href,
  class: cls = "",
} = Astro.props;

const TONES: Record<NonNullable<Props["tone"]>, { bg: string; fg: string }> = {
  primary: { bg: "bg-primary-soft", fg: "text-primary" },
  success: { bg: "bg-success-soft", fg: "text-success" },
  warning: { bg: "bg-warning-soft", fg: "text-warning" },
  info: { bg: "bg-info-soft", fg: "text-info" },
  muted: { bg: "bg-muted", fg: "text-muted-foreground" },
};

const t = TONES[tone];
---
<a
  href={href}
  class:list={[
    "group relative flex h-full flex-col justify-between gap-3 rounded-lg border border-border bg-card px-4 pt-4 pb-5 shadow-xs transition-all duration-150 hover:border-primary/30 hover:shadow-sm",
    href && "cursor-pointer press",
    cls,
  ]}
>
  {icon && (
    <div class={`absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-lg ${t.bg} ${t.fg}`}>
      <Icon name={icon} size={16} />
    </div>
  )}
  <p class="pr-12 text-xs font-medium uppercase tracking-wider text-muted-foreground">{label}</p>
  <p class="text-3xl font-bold leading-none tracking-tight tabular-nums text-foreground">{value}</p>
  {hint && <p class="truncate text-xs text-muted-foreground">{hint}</p>}
</a>
