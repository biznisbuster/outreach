---
/**
 * EditableField — inline auto-saving text/number/email/etc. input.
 *
 * <EditableField name="email" label="Email" value={lead.email} type="email" />
 *
 * - Dispatches a single PATCH through window.__leadSave(name, value) on blur (debounced).
 * - Shows a tiny per-row status indicator (idle / saving / saved / error) below the input.
 * - The page-level script coordinates all fields: collects their values, sends one PATCH per field
 *   change, and updates the global "saved at" indicator + flash toast.
 */
interface Props {
  name: string;
  label: string;
  value?: string | number | null;
  type?: "text" | "email" | "url" | "number" | "tel" | "search";
  placeholder?: string;
  required?: boolean;
  step?: number | string;
  min?: number | string;
  max?: number | string;
  class?: string;
  textarea?: boolean;
  rows?: number;
}

const {
  name,
  label,
  value,
  type = "text",
  placeholder,
  required,
  step,
  min,
  max,
  class: cls = "",
  textarea = false,
  rows = 2,
} = Astro.props;

const valStr = value === null || value === undefined ? "" : String(value);
const id = `f_${name}_${Math.random().toString(36).slice(2, 8)}`;
---
<label for={id} class:list={["block space-y-1", cls]}>
  <span class="block text-xs font-medium text-muted-foreground">
    {label}
    {required && <span class="ml-0.5 text-destructive" aria-hidden="true">*</span>}
  </span>
  {textarea ? (
    <textarea
      id={id}
      data-edit-field={name}
      rows={rows}
      placeholder={placeholder}
      class="flex w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm shadow-xs transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:border-primary"
    >{valStr}</textarea>
  ) : (
    <input
      id={id}
      data-edit-field={name}
      type={type}
      value={valStr}
      placeholder={placeholder}
      required={required}
      step={step}
      min={min}
      max={max}
      class="flex h-9 w-full rounded-md border border-input bg-background px-3 py-1.5 text-sm shadow-xs transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:border-primary"
    />
  )}
  <span data-field-status={name} aria-live="polite" class="hidden text-xs text-muted-foreground"></span>
</label>
