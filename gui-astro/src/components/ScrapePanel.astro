---
/**
 * ScrapePanel — multi-query Google Maps scrape + bulk import.
 *
 * Input: textarea, jedna pretraga po liniji. Ceo string ide kao Google
 * Maps keywords (npr. "cvecare beograd", "frizerski salon kruševac").
 * Pokreće scrape-ove SEKVENCIJALNO (jedan po jedan da ne preplavi
 * Google). Kad se svi završe, akumulira SVE redove u jednu listu i nudi
 * jedan "Uvezi sve u kampanju" dugme.
 *
 * Props:
 *   - defaultQuery?: string — initial value for the textarea (one query per line).
 *     Used to pre-fill from campaign context (category + city) so the user only
 *     has to click "Pokreni scrape".
 *   - buttonLabel?: string — overrides the submit button text (default "Pokreni scrape").
 *   - compact?: boolean — when true, the trigger form is single-row inline
 *     (no label, no descriptive text, no big card chrome). The progress /
 *     pipeline / done panels still render below the trigger in the same DOM
 *     tree, just without their surrounding card chrome. Default false.
 */
interface Props {
  defaultQuery?: string;
  buttonLabel?: string;
  compact?: boolean;
}
const { defaultQuery = "", buttonLabel = "Pokreni scrape", compact = false } = Astro.props;
---
<div class={compact ? "space-y-3" : "space-y-4"}>
  <form id="scrape-form" class={compact ? "flex items-center gap-2" : "space-y-2"}>
    {compact ? (
      <>
        <textarea
          id="s-queries"
          rows="1"
          placeholder={"cvecare beograd, cvecare kruševac"}
          class="flex h-9 w-56 rounded-md border border-input bg-background px-3 py-1 text-sm font-mono transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:border-primary"
        >{defaultQuery}</textarea>
        <button
          type="submit"
          id="scrape-start"
          data-initial-label={buttonLabel}
          class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm transition-all hover:brightness-110 active:scale-[0.985] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:opacity-50"
        >
          {buttonLabel}
        </button>
        <button
          type="button"
          id="scrape-stop"
          class="hidden inline-flex h-9 items-center justify-center rounded-md border border-destructive/30 bg-destructive-soft px-3 text-sm font-medium text-destructive hover:bg-destructive/10"
        >
          Zaustavi
        </button>
        <span id="queries-count-wrap" class="hidden text-xs text-muted-foreground">
          <strong id="queries-count" class="tabular-nums">0</strong> pretraga
        </span>
        <p id="queries-warning" class="hidden text-xs text-amber-700"></p>
      </>
    ) : (
      <>
        <div class="flex flex-wrap items-center gap-2">
          <textarea
            id="s-queries"
            rows="1"
            placeholder={"cvecare beograd, cvecare kruševac, frizerski salon novi sad"}
            class="flex h-9 min-w-[260px] flex-1 rounded-md border border-input bg-background px-3 py-1 font-mono text-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 focus-visible:border-primary"
          >{defaultQuery}</textarea>
          <button
            type="submit"
            id="scrape-start"
            data-initial-label={buttonLabel}
            class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm transition-all hover:brightness-110 active:scale-[0.985] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:opacity-50"
          >
            {buttonLabel}
          </button>
          <button
            type="button"
            id="scrape-stop"
            class="hidden inline-flex h-9 items-center justify-center rounded-md border border-destructive/30 bg-destructive-soft px-4 text-sm font-medium text-destructive hover:bg-destructive/10"
          >
            Zaustavi
          </button>
          <span id="queries-count-wrap" class="hidden text-xs text-muted-foreground">
            <strong id="queries-count" class="tabular-nums">0</strong> pretraga
          </span>
          <p id="queries-warning" class="hidden text-xs text-warning"></p>
        </div>
        <p class="text-xs text-muted-foreground">
          Ceo tekst ide kao Google Maps pretraga. Više upita odvoji zarezom ili novom linijom (Shift+Enter).
        </p>
      </>
    )}
  </form>

  <!-- Pipeline indicator (stepper) -->
  <div id="pipeline" class="hidden w-full">
    <ol class="flex flex-wrap items-center gap-x-1 gap-y-2 text-xs">
      <li class="stage flex items-center gap-1.5" data-stage="startup">
        <span class="stage-dot flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-muted-foreground"><span class="stage-icon"></span></span>
        <span class="stage-label text-muted-foreground">Startup</span>
      </li>
      <li class="stage-connector h-px w-4 shrink-0 bg-border sm:w-7"></li>
      <li class="stage flex items-center gap-1.5" data-stage="search">
        <span class="stage-dot flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-muted-foreground"><span class="stage-icon"></span></span>
        <span class="stage-label text-muted-foreground">Maps pretraga</span>
      </li>
      <li class="stage-connector h-px w-4 shrink-0 bg-border sm:w-7"></li>
      <li class="stage flex items-center gap-1.5" data-stage="detail">
        <span class="stage-dot flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-muted-foreground"><span class="stage-icon"></span></span>
        <span class="stage-label text-muted-foreground">Detalji</span>
      </li>
      <li class="stage-connector h-px w-4 shrink-0 bg-border sm:w-7"></li>
      <li class="stage flex items-center gap-1.5" data-stage="email">
        <span class="stage-dot flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-muted-foreground"><span class="stage-icon"></span></span>
        <span class="stage-label text-muted-foreground">Email extraction</span>
      </li>
      <li class="stage-connector h-px w-4 shrink-0 bg-border sm:w-7"></li>
      <li class="stage flex items-center gap-1.5" data-stage="export">
        <span class="stage-dot flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-border bg-muted text-muted-foreground"><span class="stage-icon"></span></span>
        <span class="stage-label text-muted-foreground">Gotovo</span>
      </li>
    </ol>
  </div>

  <!-- Status panel (trenutni job) -->
  <div id="scrape-panel" class="hidden w-full space-y-3 rounded-lg border border-border bg-card p-4 shadow-xs">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <svg id="spinner" class="h-4 w-4 animate-spin text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="font-medium text-foreground" id="phase-label">Šaljem zahtev…</span>
      </div>
      <span class="text-xs text-muted-foreground tabular-nums" id="scrape-elapsed"></span>
    </div>

    <div class="text-xs text-muted-foreground" id="current-job"></div>

    <div>
      <div class="mb-1 flex items-center justify-between text-xs text-muted-foreground">
        <span id="scrape-count" class="tabular-nums">0 / 0</span>
        <span id="scrape-eta"></span>
      </div>
      <div class="h-2 overflow-hidden rounded-full bg-muted">
        <div id="scrape-bar" class="h-full rounded-full bg-primary transition-all duration-300" style="width: 0%"></div>
      </div>
    </div>

    <div id="scrape-msg" class="rounded-md border border-border bg-muted/40 p-2 font-mono text-xs text-foreground/80"></div>

    <details class="group/events">
      <summary class="flex cursor-pointer items-center gap-1.5 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground [&::-webkit-details-marker]:hidden">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open/events:rotate-90" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        Event log (poslednjih 10)
      </summary>
      <ul id="scrape-events" class="mt-2 max-h-48 space-y-0.5 overflow-y-auto rounded-md border border-border bg-muted/40 p-2 font-mono text-xs text-muted-foreground"></ul>
    </details>
  </div>

  <!-- Done panel (svi scrape-ovi završeni) -->
  <div id="scrape-done" class="hidden w-full space-y-3 rounded-lg border border-success/30 bg-success-soft p-4">
    <div class="flex items-start justify-between gap-2">
      <div class="min-w-0">
        <div class="font-medium text-foreground" id="done-title">Scrape završen</div>
        <div class="mt-0.5 text-sm text-foreground/80" id="done-summary"></div>
        <div class="mt-1 text-xs text-foreground/70" id="done-breakdown"></div>
      </div>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-success" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
    </div>

    <!-- Preview lista pronađenih leadova (pre importa) -->
    <div id="scrape-preview" class="hidden"></div>

    <div class="flex flex-wrap items-center gap-2 pt-2">
      <button type="button" id="import-btn" class="inline-flex h-9 items-center rounded-md bg-success px-4 text-sm font-medium text-success-foreground shadow-sm transition-all hover:brightness-110 active:scale-[0.985] disabled:opacity-50">
        Uvezi sve u kampanju
      </button>
      <label
        class="inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-md border border-warning/30 bg-warning-soft px-3 text-xs font-medium text-foreground hover:bg-warning-soft/80"
        title="Ako je uključeno, preskače dedup logiku i ubaci SVE redove kao nove (čak i ako već postoje u nekoj kampanji). Korisno posle bulk delete da ponovo uvezeš iste biznise."
      >
        <input
          type="checkbox"
          id="import-force"
          class="h-3.5 w-3.5 cursor-pointer accent-warning"
        />
        Uvezi svejedno
      </label>
      <a id="open-leads" href="/leads" class="inline-flex h-9 items-center rounded-md border border-border bg-background px-3 text-sm transition-colors hover:bg-accent">
        Otvori leadove
      </a>
      <button type="button" id="restart-btn" class="inline-flex h-9 items-center rounded-md border border-border bg-background px-3 text-sm transition-colors hover:bg-accent">
        Novi scrape
      </button>
      <button type="button" id="reload-btn" class="hidden inline-flex h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm transition-all hover:brightness-110 active:scale-[0.985]">
        Pogledaj rezultate
      </button>
    </div>

    <!-- Detaljna lista duplikata posle importa -->
    <div id="duplicate-details" class="hidden"></div>
  </div>
</div>

<script is:inline>
  (function () {
    var form = document.getElementById("scrape-form");
    var queriesEl = document.getElementById("s-queries");
    var queriesCount = document.getElementById("queries-count");
    var queriesWarning = document.getElementById("queries-warning");
    var btn = document.getElementById("scrape-start");
    var stopBtn = document.getElementById("scrape-stop");
    var pipeline = document.getElementById("pipeline");
    var panel = document.getElementById("scrape-panel");
    var phaseLabel = document.getElementById("phase-label");
    var currentJobEl = document.getElementById("current-job");
    var msg = document.getElementById("scrape-msg");
    var count = document.getElementById("scrape-count");
    var eta = document.getElementById("scrape-eta");
    var bar = document.getElementById("scrape-bar");
    var elapsed = document.getElementById("scrape-elapsed");
    var events = document.getElementById("scrape-events");
    var donePanel = document.getElementById("scrape-done");
    var doneSummary = document.getElementById("done-summary");
    var doneBreakdown = document.getElementById("done-breakdown");
    var importBtn = document.getElementById("import-btn");
    var openLeads = document.getElementById("open-leads");
    var restartBtn = document.getElementById("restart-btn");
    var reloadBtn = document.getElementById("reload-btn");

    var campaignId = window.location.pathname.match(/^\/campaigns\/(\d+)/);
    campaignId = campaignId ? Number(campaignId[1]) : null;
    if (campaignId) openLeads.href = "/leads?campaignId=" + campaignId;

    var STAGE_LABEL = {
      startup: "Startup",
      search: "Maps pretraga",
      detail: "Detalji",
      email: "Email extraction",
      export: "Eksport",
      done: "Gotovo",
      captcha: "Captcha",
    };

    // Mapiranje sub-stage-ova (koje scraper emituje: screenshot, contact,
    // google_fallback, email) na DISPLAY stage u stepper-u/countu. Svi ovi
    // su deo "Detalji" faze iz korisničke perspektive — u suprotnom stepper
    // flickuje između "Detalji" i ničega svaki put kad dođe screenshot event.
    var STAGE_DISPLAY_MAP = {
      startup: "startup",
      search: "search",
      detail: "detail",
      screenshot: "detail",
      contact: "detail",
      google_fallback: "detail",
      email: "detail",
      captcha: "captcha",
      export: "export",
      done: "done",
    };
    function displayStage(s) { return STAGE_DISPLAY_MAP[s] || s; }

    // STATE: drži listu query-eva i akumulirane redove za bulk import
    var STATE = {
      queries: [],            // ["cvecare beograd", "cvecare krusevac"]
      currentIndex: 0,
      jobIds: [],             // jobId za svaki query (ili null ako preskočen)
      jobs: [],               // [{query, jobId, rows:[], status, error, rowsWritten}]
      allRows: [],            // svi redovi spojeni za bulk import
      pollHandle: null,
      startTs: 0,
      total: 0,
      evList: [],
      stopped: false,
      _lastEvSig: "",         // dedup potpis zadnjeg eventa (sprečava replay)
      _detailStartTs: 0,      // kada je počela detail faza (za realan ETA)
      _detailStarted: false,  // da li smo ušli u detail fazu
      _maxCount: 0,           // monotonic count — nikad ne pada, prati cumulative
      _maxPct: 0,             // monotonic progress — bar nikad ne pada unazad
      _lastDisplayStage: "",  // poslednji display stage (za skip nepotrebnih setStage poziva)
      _emaRate: null,         // exponential moving average rate biznisa/ms (za stabilan ETA)
      _lastEtaUpdate: 0,      // throttling: ne ažuriraj ETA DOM češće od 2s
    };

    var reloadTimer = null;   // auto-reload nakon uspešnog importa

    // === helpers ===

    // SVG icons used inside the stepper dots
    var SPINNER_SVG = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>';
    var CHECK_SVG = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

    function setStage(s) {
      var raw = s;
      s = displayStage(s);
      // CRITICAL: Ako se display stage NIJE PROMENIO, ne diramo DOM. Ovo
      // sprečava flicker pipelne indikatotra na screenshot/contact/email
      // eventima — svi se mapiraju na "detail" pa setStage("screenshot")
      // postaje no-op za DOM.
      if (s === STATE._lastDisplayStage) return;
      STATE._lastDisplayStage = s;
      var stages = ["startup", "search", "detail", "email", "export", "done"];
      var reached = false;
      for (var i = 0; i < stages.length; i++) {
        var li = document.querySelector(".stage[data-stage='" + stages[i] + "']");
        if (!li) continue;
        var dot = li.querySelector(".stage-dot");
        var label = li.querySelector(".stage-label");
        var icon = li.querySelector(".stage-icon");

        // remove prior state
        dot.classList.remove(
          "bg-muted", "text-muted-foreground", "border-border",
          "bg-primary", "text-primary-foreground", "border-primary",
          "bg-success", "text-success-foreground", "border-success"
        );
        label.classList.remove("text-muted-foreground", "text-primary", "text-success", "font-semibold");
        icon.innerHTML = "";

        if (stages[i] === s) {
          // Active
          dot.classList.add("bg-primary", "text-primary-foreground", "border-primary", "shadow-sm");
          label.classList.add("text-primary", "font-semibold");
          icon.innerHTML = SPINNER_SVG;
          reached = true;
        } else if (!reached) {
          // Done (only stages before active)
          dot.classList.add("bg-success", "text-success-foreground", "border-success");
          label.classList.add("text-success");
          icon.innerHTML = CHECK_SVG;
        } else {
          // Pending — re-apply base classes
          dot.classList.add("bg-muted", "text-muted-foreground", "border-border");
          label.classList.add("text-muted-foreground");
          icon.innerHTML = '<span class="block h-1.5 w-1.5 rounded-full bg-muted-foreground/60"></span>';
        }
      }

      // Color the connectors between done stages
      var connectors = document.querySelectorAll(".stage-connector");
      for (var j = 0; j < connectors.length; j++) {
        if (j < reachedIdx(s)) {
          connectors[j].classList.add("bg-success");
          connectors[j].classList.remove("bg-border");
        } else {
          connectors[j].classList.remove("bg-success");
          connectors[j].classList.add("bg-border");
        }
      }
    }

    function reachedIdx(s) {
      var stages = ["startup", "search", "detail", "email", "export", "done"];
      return stages.indexOf(s);
    }

    // Captcha escalation: surface a captcha warning in the phase label.
    (function () {
      var origSet = setStage;
      setStage = function (s) {
        origSet(s);
        if (s === "captcha") {
          phaseLabel.textContent = "⚠ Captcha zahteva ponovni pokušaj";
          phaseLabel.classList.add("text-warning");
        } else {
          phaseLabel.classList.remove("text-warning");
        }
      };
    })();

    function fmtElapsed(ms) {
      var s = Math.floor(ms / 1000);
      if (s < 60) return s + "s";
      var m = Math.floor(s / 60); var ss = s % 60;
      return m + "m " + String(ss).padStart(2, "0") + "s";
    }

    function setEta(done, total, stage) {
      // ETA računamo samo za "detail" display-stage (glavna faza). Van nje
      // (startup/search/export/done), ne prikazujemo ništa.
      if (stage !== "detail") {
        if (done >= total && total > 0) eta.textContent = "Završeno";
        else eta.textContent = "";
        STATE._emaRate = null;
        return;
      }
      // Ako ne znamo total još (search/end tek treba stići), prikaži
      // "računam…" — bez besmislenih procena.
      if (!total || total <= 0 || !STATE._detailStartTs) {
        eta.textContent = "ETA: računam…";
        return;
      }
      // Završeno
      if (done >= total) {
        eta.textContent = "Završeno";
        STATE._emaRate = null;
        return;
      }
      // Premalo uzoraka za stabilan rate (treba bar ~3s da bi rate bio smislen)
      var now = Date.now();
      var detailElapsed = now - STATE._detailStartTs;
      if (detailElapsed < 2000) {
        eta.textContent = "ETA: računam…";
        return;
      }
      // EMA — exponential moving average — zaglađuje rate između polova da
      // ETA ne treperi (npr. 3m20s → 3m18s → 3m22s svakih 1.5s).
      var currentRate = done / detailElapsed; // biznisa / ms
      var alpha = 0.3;
      STATE._emaRate = (STATE._emaRate == null)
        ? currentRate
        : alpha * currentRate + (1 - alpha) * STATE._emaRate;
      // Throttle: ne ažuriraj DOM češće od 2s (inače tekst treperi)
      if (STATE._lastEtaUpdate && now - STATE._lastEtaUpdate < 2000) return;
      STATE._lastEtaUpdate = now;

      if (STATE._emaRate > 0) {
        var remaining = (total - done) / STATE._emaRate; // ms
        var sm = Math.round(remaining / 1000);
        // Cap na 99m da ne piše "1h 23m" kad je zapravo samo ~90min.
        if (sm <= 0) eta.textContent = "ETA: <1s";
        else if (sm < 60) eta.textContent = "ETA: ~" + sm + "s";
        else eta.textContent = "ETA: ~" + Math.min(99, Math.floor(sm / 60)) + "m " + String(sm % 60).padStart(2, "0") + "s";
      } else {
        eta.textContent = "ETA: računam…";
      }
    }

    function addEv(ev) {
      // Dedup: ne dodaj isti event dva puta. Poll vraća last_event svakih
      // 1.5s i bez ove provere bi se isti red pojavio "milion puta" u log-u.
      var sig = ev.stage + "/" + ev.event + "/" + ev.count + "/" + (ev.message || "");
      if (STATE._lastEvSig === sig) return;
      STATE._lastEvSig = sig;
      STATE.evList.unshift(ev);
      if (STATE.evList.length > 10) STATE.evList.length = 10;
      events.innerHTML = STATE.evList.map(function (e) {
        var d = new Date(e.timestamp || Date.now()).toLocaleTimeString();
        return "<li><span class='text-muted-foreground/70'>" + d + "</span> <span class='text-foreground/80'>[" + e.stage + "/" + e.event + "]</span> " + (e.message || "") + "</li>";
      }).join("");
    }

    // Render event log iz pune istorije (events[] iz snapshot-a) — koristi se
    // na početku svakog job-a da se prikaže sve što se desilo, bez replay-a.
    function renderEventHistory(evList) {
      if (!evList || !evList.length) return;
      var seen = {};
      var deduped = [];
      for (var i = evList.length - 1; i >= 0; i--) {
        var e = evList[i];
        var sig = e.stage + "/" + e.event + "/" + e.count + "/" + (e.message || "");
        if (seen[sig]) continue;
        seen[sig] = true;
        deduped.unshift(e);
      }
      // zadnjih 10, najnoviji prvi
      STATE.evList = deduped.slice(-10).reverse();
      STATE._lastEvSig = evList[evList.length - 1]
        ? evList[evList.length - 1].stage + "/" + evList[evList.length - 1].event + "/" + evList[evList.length - 1].count + "/" + (evList[evList.length - 1].message || "")
        : "";
      events.innerHTML = STATE.evList.map(function (e) {
        var d = new Date(e.timestamp || Date.now()).toLocaleTimeString();
        return "<li><span class='text-muted-foreground/70'>" + d + "</span> <span class='text-foreground/80'>[" + e.stage + "/" + e.event + "]</span> " + (e.message || "") + "</li>";
      }).join("");
    }

    function tickElapsed() {
      elapsed.textContent = "Trajanje: " + fmtElapsed(Date.now() - STATE.startTs);
    }

    // === textarea helpers ===

    function getQueries() {
      return (queriesEl.value || "")
        .split(/[\n,]+/)
        .map(function (s) { return s.trim(); })
        .filter(Boolean);
    }

    function refreshQueriesCount() {
      var qs = getQueries();
      queriesCount.textContent = String(qs.length);
      var wrap = document.getElementById("queries-count-wrap");
      if (wrap) wrap.classList.toggle("hidden", qs.length === 0);
      if (qs.length > 10) {
        queriesWarning.textContent = "⚠ " + qs.length + " pretraga može trajati dugo (sekvencijalno).";
        queriesWarning.classList.remove("hidden");
      } else {
        queriesWarning.classList.add("hidden");
      }
    }
    queriesEl.addEventListener("input", refreshQueriesCount);
    refreshQueriesCount();

    // === lifecycle ===

    var elapsedIv = null;
    var stopRequested = false;

    function showRunningUI() {
      btn.disabled = true;
      btn.textContent = STATE.queries.length > 1
        ? "Pretraga " + (STATE.currentIndex + 1) + " / " + STATE.queries.length
        : "Pokrećem…";
      stopBtn.classList.remove("hidden");
      pipeline.classList.remove("hidden");
      panel.classList.remove("hidden");
      donePanel.classList.add("hidden");
    }

    function showStartUI() {
      btn.disabled = false;
      btn.textContent = btn.getAttribute("data-initial-label") || "Pokreni scrape";
      stopBtn.classList.add("hidden");
      if (elapsedIv) { clearInterval(elapsedIv); elapsedIv = null; }
    }

    function resetUI() {
      if (reloadTimer) { clearInterval(reloadTimer); reloadTimer = null; }
      STATE = {
        queries: [], currentIndex: 0, jobIds: [], jobs: [],
        allRows: [], pollHandle: null, startTs: 0, total: 0,
        evList: [], stopped: false,
        _lastEvSig: "", _detailStartTs: 0, _detailStarted: false,
        _maxCount: 0, _maxPct: 0, _lastDisplayStage: "",
        _emaRate: null, _lastEtaUpdate: 0,
      };
      stopRequested = false;
      msg.textContent = "";
      count.textContent = "0 / 0";
      bar.style.width = "0%";
      elapsed.textContent = "Trajanje: 0s";
      currentJobEl.textContent = "";
      events.innerHTML = "";
      // Reset stepper back to pending state
      setStage("");
      document.querySelectorAll(".stage-connector").forEach(function (c) {
        c.classList.remove("bg-success");
        c.classList.add("bg-border");
      });
      phaseLabel.classList.remove("text-amber-700", "text-red-700");
      phaseLabel.textContent = "Šaljem zahtev…";
      doneSummary.textContent = "";
      doneBreakdown.textContent = "";
      importBtn.textContent = "Uvezi sve u kampanju";
      importBtn.classList.remove("hidden");
      importBtn.disabled = false;
      reloadBtn.classList.add("hidden");
      showStartUI();
      panel.classList.add("hidden");
      pipeline.classList.add("hidden");
      donePanel.classList.add("hidden");
    }

    // === start a single job ===

    async function startOneJob(query) {
      // Reset progress za ovaj job
      STATE.total = 0;
      STATE.evList = [];
      STATE._lastEvSig = "";
      STATE._detailStartTs = 0;
      STATE._detailStarted = false;
      STATE._maxCount = 0;
      STATE._maxPct = 0;
      STATE._lastDisplayStage = "";
      STATE._emaRate = null;
      STATE._lastEtaUpdate = 0;
      events.innerHTML = "";
      msg.textContent = "";
      count.textContent = "0 / ?";
      bar.style.width = "0%";

      currentJobEl.textContent =
        "Pretraga " + (STATE.currentIndex + 1) + " / " + STATE.queries.length +
        ": " + query;

      try {
        var r = await fetch("/api/scrape-leads", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Origin": location.origin },
          body: JSON.stringify({
            query: query, country: "RS", language: "sr",
            max_results: 25, extract_emails: true,
          }),
        });
        var d = await r.json().catch(function () { return {}; });
        if (!r.ok || !d.jobId) {
          var errMsg = (d && d.error) || ("HTTP " + r.status);
          STATE.jobs.push({ query: query, jobId: null, rows: [], status: "failed", error: errMsg, rowsWritten: 0 });
          msg.innerHTML = "<span class='text-red-600'>" + errMsg + "</span>";
          return { ok: false, error: errMsg };
        }
        STATE.jobIds.push(d.jobId);
        STATE.jobs.push({ query: query, jobId: d.jobId, rows: [], status: "running", error: null, rowsWritten: 0 });
        phaseLabel.textContent = "Scrape pokrenut: " + d.jobId;
        return { ok: true, jobId: d.jobId };
      } catch (e) {
        STATE.jobs.push({ query: query, jobId: null, rows: [], status: "failed", error: e.message, rowsWritten: 0 });
        msg.innerHTML = "<span class='text-red-600'>Mrežna greška: " + e.message + "</span>";
        return { ok: false, error: e.message };
      }
    }

    // === poll single job until done ===

    // Centralizovano računanje monotonic progresije (count + bar + stage).
    // Ključni principi:
    //   1. count.text i bar.width NIKAD ne idu UNAZAD tokom jednog job-a.
    //   2. _maxCount prati KUMULATIVNI broj biznisa (dolazi iz detail/start i
    //      detail/end eventa). screenshot/contact/google_fallback eventi
    //      imaju count=0 ili count=emailed — ignorišu se za prikaz.
    //   3. Bar se računa iz _maxCount / STATE.total (ne iz ev.count direktno).
    //   4. Steper koristi displayStage() mapu — sub-stages ne menjaju vizuel.
    // Centralizovano računanje monotonic progresije (count + bar + stage).
    // Ključni principi:
    //   1. count.text i bar.width NIKAD ne idu UNAZAD tokom jednog job-a.
    //   2. STATE.total je ROBUSNO izveden iz pune istorije događaja
    //      (snap.events), ne samo iz last_event. Razlog: scraper emituje
    //      search/end samo jednom, a last_event se prepisuje svakim emitom.
    //      Polling svakih 1.5s može nikad ne videti search/end kao last_event
    //      (ako scraper radi brzo) — pa STATE.total ostane 0 i prikazuje "?".
    //   3. _maxCount prati KUMULATIVNI broj biznisa (dolazi iz detail/start i
    //      detail/end eventa). screenshot/contact/google_fallback eventi
    //      imaju count=0 ili count=emailed — ignorišu se za prikaz.
    //   4. Bar se računa iz _maxCount / STATE.total (ne iz ev.count direktno).
    //   5. Steper koristi displayStage() mapu — sub-stages ne menjaju vizuel.
    function applyProgress(ev, allEvents) {
      if (!ev && !allEvents) return;

      // ROBUSNO IZVLAČENJE TOTAL: prvo skeniraj celu istoriju događaja
      // i zaključaj STATE.total čim nađeš bilo koji event sa total > 0.
      // Pošto je search/end emitovan rano u toku, a kasniji detail/end
      // imaju isti total (=len(urls)), dovoljno je jedno skeniranje.
      if (allEvents) {
        for (var i = 0; i < allEvents.length; i++) {
          var eh = allEvents[i];
          if (eh && eh.total && eh.total > 0 && (
            eh.stage === "search" || eh.stage === "detail" ||
            eh.stage === "export" || eh.stage === "done"
          )) {
            STATE.total = eh.total;
            break;
          }
        }
      }
      // Takođe probaj iz samog ev (za slučaj prazne events liste)
      if (ev && ev.total && ev.total > 0 && !STATE.total) {
        STATE.total = ev.total;
      }

      var rawStage = ev && ev.stage;
      var ds = ev ? displayStage(rawStage) : null;
      var ec = ev ? (ev.count || 0) : 0;

      // search/end: zaključaj total = broj pronađenih URL-ova, bar ide na 100%
      if (ev && rawStage === "search" && ev.event === "end") {
        STATE._maxCount = Math.max(STATE._maxCount, ec);
        STATE._maxPct = 100;
      }
      // detail faza — glavni rad, cumulative count
      else if (ds === "detail") {
        if (!STATE._detailStarted) {
          STATE._detailStarted = true;
          if (!STATE._detailStartTs) STATE._detailStartTs = Date.now();
          STATE._maxCount = 0;
          STATE._maxPct = 0;
        }
        // Samo detail/start i detail/end imaju cumulative count.
        // screenshot/contact/google_fallback imaju count=0 ili count=emailed.
        if (rawStage === "detail" && (ev.event === "start" || ev.event === "end" || ev.event === "skip" || ev.event === "error")) {
          STATE._maxCount = Math.max(STATE._maxCount, ec);
        }
        if (STATE.total) {
          var npct = Math.min(100, Math.round((STATE._maxCount / STATE.total) * 100));
          STATE._maxPct = Math.max(STATE._maxPct, npct);
        }
      }
      // export/done: 100%
      else if (ds === "export" || ds === "done") {
        if (STATE.total) STATE._maxCount = STATE.total;
        STATE._maxPct = 100;
      }
      // startup: ne diramo progres (pokazuje 0/? dok ne krene search)

      // Ažuriraj DOM — uvek monotonic
      count.textContent = STATE._maxCount + " / " + (STATE.total || "?");
      bar.style.width = STATE._maxPct + "%";
      if (ev) {
        msg.textContent = "[" + ds + "] " + (ev.message || ev.event);
        phaseLabel.textContent = STAGE_LABEL[ds] || ds;
      }
    }

    function waitForJobFinish(jobId) {
      return new Promise(function (resolve) {
        var job = STATE.jobs[STATE.jobs.length - 1];
        function loop() {
          if (stopRequested) {
            job.status = "stopped";
            resolve();
            return;
          }
          fetch("/api/scrape-leads/progress/" + jobId, { headers: { "Origin": location.origin } })
            .then(function (r) { return r.ok ? r.json() : null; })
            .catch(function () { return null; })
            .then(function (pd) {
              var snap = pd && pd.snapshot;
              var ev = snap && snap.last_event;
              // Render pune istorije eventa (ako scraper šalje events[]) —
              // prikazuje SVE šta se desilo, bez replay-a last_event-a.
              if (snap && snap.events && snap.events.length) {
                renderEventHistory(snap.events);
              }
              if (ev || (snap && snap.events && snap.events.length)) {
                // applyProgress: monotonic count + monotonic bar + mapiran stage.
                // Prosleđujemo i snap.events jer STATE.total mora da se izvuče
                // iz celokupne istorije (search/end se može preskočiti u last_event).
                applyProgress(ev, snap && snap.events);
                if (ev) {
                  addEv(ev);
                  setStage(ev.stage);
                  setEta(STATE._maxCount, STATE.total, displayStage(ev.stage));
                }
              }
              return fetch("/api/scrape-leads/status/" + jobId, { headers: { "Origin": location.origin } });
            })
            .then(function (r) { return r ? r.json() : null; })
            .catch(function () { return null; })
            .then(function (sd) {
              if (!sd) { setTimeout(loop, 1500); return; }
              var st = sd.status;
              job.rowsWritten = sd.rowsWritten || 0;
              if (st === "done" || st === "empty" || st === "captcha" || st === "failed") {
                job.status = st;
                job.error = sd.error || null;
                setStage(st === "done" ? "done" : st);
                resolve();
                return;
              }
              setTimeout(loop, 1500);
            });
        }
        loop();
      });
    }

    // === fetch rows for one finished job ===

    async function fetchJobRows(jobId) {
      // VAŽNO: scraper-leads endpoint je POST (FastAPI @app.post). Stari GET
      // je vraćao 405 "Method Not Allowed" pa je import prikazivao prazno.
      var r = await fetch("/api/scrape-leads/import/" + jobId, {
        method: "POST",
        headers: { "Origin": location.origin },
      });
      if (!r.ok) {
        var txt = await r.text().catch(function () { return ""; });
        throw new Error("HTTP " + r.status + ": " + txt);
      }
      var data = await r.json();
      return (data && data.rows) || [];
    }

    // === main flow ===

    async function runAll() {
      STATE.startTs = Date.now();
      elapsedIv = setInterval(tickElapsed, 500);
      showRunningUI();

      for (STATE.currentIndex = 0; STATE.currentIndex < STATE.queries.length; STATE.currentIndex++) {
        if (stopRequested) break;
        var query = STATE.queries[STATE.currentIndex];
        btn.textContent = STATE.queries.length > 1
          ? "Pretraga " + (STATE.currentIndex + 1) + " / " + STATE.queries.length
          : "Pokrećem…";

        var started = await startOneJob(query);
        if (!started.ok) continue;

        // čekaj da se ovaj job završi
        await waitForJobFinish(started.jobId);

        // akumuliraj redove ako je uspeo
        var job = STATE.jobs[STATE.jobs.length - 1];
        if (job.status === "done" && job.jobId) {
          try {
            job.rows = await fetchJobRows(job.jobId);
            STATE.allRows = STATE.allRows.concat(job.rows);
          } catch (e) {
            job.error = (job.error ? job.error + "; " : "") + "fetch rows: " + e.message;
          }
        }
      }

      if (elapsedIv) { clearInterval(elapsedIv); elapsedIv = null; }
      showStartUI();

      if (stopRequested) {
        // korisnik je stao nasred
        finishAll(false, "Pretraga zaustavljena. " + STATE.allRows.length + " leadova do sada.");
        return;
      }

      // Svi završeni. Prikaži summary.
      var total = STATE.allRows.length;
      var successful = STATE.jobs.filter(function (j) { return j.status === "done"; }).length;
      var failed = STATE.jobs.filter(function (j) { return j.status === "failed" || j.status === "captcha" || j.status === "empty"; }).length;
      var totalTime = fmtElapsed(Date.now() - STATE.startTs);

      if (total === 0) {
        finishAll(true, "Nema rezultata ni za jednu pretragu. " + failed + " neuspešno.");
        return;
      }

      var breakdown = STATE.jobs
        .filter(function (j) { return j.rowsWritten > 0; })
        .map(function (j, i) { return (i + 1) + ". " + j.query + " → " + j.rowsWritten; })
        .join(" · ");
      finishAll(true, "Pronađeno ukupno " + total + " leadova iz " + successful + " pretraga za " + totalTime + ".", breakdown);
    }

    function finishAll(success, summary, breakdown) {
      bar.style.width = "100%";
      doneSummary.textContent = summary;
      doneBreakdown.textContent = breakdown || "";
      panel.classList.add("hidden");
      pipeline.classList.add("hidden");
      donePanel.classList.remove("hidden");
      if (success && STATE.allRows.length > 0) {
        renderPreview(STATE.allRows);
        importBtn.disabled = false;
        importBtn.classList.remove("hidden");
        importBtn.textContent = "Uvezi sve u kampanju (" + STATE.allRows.length + ")";
        reloadBtn.classList.add("hidden");
      } else {
        importBtn.disabled = true;
        importBtn.textContent = "Nema rezultata za uvoz";
      }
      // Skroluj do done panel-a da korisnik odmah vidi rezultate.
      try { donePanel.scrollIntoView({ behavior: "smooth", block: "nearest" }); } catch (e) {}
    }

    // Renderuje preview tabelu pronađenih leadova — korisnik ODMAH vidi šta je
    // scrape našao (ime, telefon, website, email, ocena) pre nego što uvozi.
    function renderPreview(rows) {
      var box = document.getElementById("scrape-preview");
      if (!box || !rows || !rows.length) { if (box) box.classList.add("hidden"); return; }

      var withEmail = rows.filter(function (r) { return r.email && r.email.trim(); }).length;
      var withPhone = rows.filter(function (r) { return (r.phone_e164 || r.phone_raw || "").trim(); }).length;
      var withWeb = rows.filter(function (r) { return (r.website || "").trim(); }).length;

      var html = '<div class="rounded-md border border-border bg-background/60">';
      html += '<div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-border px-3 py-2 text-xs text-muted-foreground">';
      html += '<span class="font-medium text-foreground">' + rows.length + ' leadova</span>';
      html += '<span>📞 ' + withPhone + '</span>';
      html += '<span>🌐 ' + withWeb + '</span>';
      html += '<span>✉ ' + withEmail + '</span>';
      html += '</div>';
      html += '<div class="max-h-72 overflow-y-auto">';
      html += '<table class="w-full text-xs"><thead class="sticky top-0 bg-muted/80 text-left uppercase tracking-wide text-muted-foreground">';
      html += '<tr><th class="px-3 py-1.5 font-medium">Naziv</th><th class="px-3 py-1.5 font-medium">Telefon</th><th class="px-3 py-1.5 font-medium">Website</th><th class="px-3 py-1.5 font-medium">Email</th><th class="px-3 py-1.5 font-medium text-right">★</th></tr>';
      html += '</thead><tbody class="divide-y divide-border">';
      rows.forEach(function (r) {
        var phone = (r.phone_raw || r.phone_e164 || "").trim();
        var web = (r.website || "").trim();
        var email = (r.email || "").trim();
        var rating = r.rating ? "★" + r.rating : "";
        var cityTxt = r.city ? " · " + r.city : "";
        // Skrati website za prikaz
        var webShort = web.replace(/^https?:\/\//, "").replace(/^www\./, "");
        if (webShort.length > 32) webShort = webShort.slice(0, 30) + "…";
        html += '<tr class="hover:bg-accent/40">';
        html += '<td class="px-3 py-1.5 font-medium text-foreground">' + escHtml(r.name || "") + '<span class="text-muted-foreground">' + escHtml(cityTxt) + '</span></td>';
        html += '<td class="px-3 py-1.5 tabular-nums ' + (phone ? "text-foreground" : "text-muted-foreground/40") + '">' + escHtml(phone || "—") + '</td>';
        html += '<td class="px-3 py-1.5 ' + (web ? "text-primary" : "text-muted-foreground/40") + '">' + (web ? '<a href="' + escAttr(web) + '" target="_blank" rel="noopener" class="hover:underline">' + escHtml(webShort) + '</a>' : "—") + '</td>';
        html += '<td class="px-3 py-1.5 ' + (email ? "text-foreground" : "text-muted-foreground/40") + '">' + (email ? '<a href="mailto:' + escAttr(email) + '" class="hover:underline">' + escHtml(email) + '</a>' : "—") + '</td>';
        html += '<td class="px-3 py-1.5 text-right tabular-nums ' + (rating ? "text-warning" : "text-muted-foreground/40") + '">' + (rating || "—") + '</td>';
        html += '</tr>';
      });
      html += '</tbody></table></div></div>';
      box.innerHTML = html;
      box.classList.remove("hidden");
    }

    function escHtml(s) {
      return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
    function escAttr(s) {
      return String(s).replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");
    }

    function showReloadCta() {
      // Sakrij import dugme i preview, prikaži "Pogledaj rezultate".
      importBtn.classList.add("hidden");
      var preview = document.getElementById("scrape-preview");
      if (preview) preview.classList.add("hidden");
      reloadBtn.classList.remove("hidden");
      reloadBtn.textContent = "Pogledaj rezultate";
      // Ako korisnik klikne pre auto-reload-a, otkaži timer
      reloadBtn.addEventListener("click", function () {
        if (reloadTimer) { clearInterval(reloadTimer); reloadTimer = null; }
        window.location.reload();
      }, { once: true });
    }

    // === event handlers ===

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var qs = getQueries();
      if (qs.length === 0) {
        msg.innerHTML = "<span class='text-amber-600'>Unesi bar jednu pretragu.</span>";
        panel.classList.remove("hidden");
        return;
      }
      resetUI();
      STATE.queries = qs;
      runAll();
    });

    stopBtn.addEventListener("click", function () {
      stopRequested = true;
      stopBtn.disabled = true;
      stopBtn.textContent = "Zaustavljanje…";
    });

    importBtn.addEventListener("click", async function () {
      var forceChk = document.getElementById("import-force");
      var forceEnabled = forceChk && forceChk.checked;
      importBtn.disabled = true;
      importBtn.textContent = "Uvozim " + STATE.allRows.length + " leadova…";
      try {
        // Pošalji SVE akumulirane redove u jedan bulk import.
        // jobId koristimo samo prvog joba za verifikaciju (server radi best-effort).
        var firstJobId = STATE.jobIds[0] || "";
        var ir = await fetch("/api/scrape-leads/import", {
          method: "POST",
          headers: { "Content-Type": "application/json", "Origin": location.origin },
          body: JSON.stringify({
            jobId: firstJobId,
            campaignId: campaignId,
            force: forceEnabled,
            rows: STATE.allRows,
          }),
        });
        var id = await ir.json().catch(function () { return {}; });
        if (ir.ok) {
          var parts = [];
          if (id.created) parts.push(id.created + " novih");
          if (id.updated) parts.push(id.updated + " ažurirano");
          if (id.duplicates) parts.push(id.duplicates + " duplikata");
          if (id.skipped) parts.push(id.skipped + " preskočeno");
          importBtn.textContent = "✅ Uvezeno: " + (parts.join(", ") || "0 izmena");
          // ostavi dugme onemogućeno da korisnik ne uveze duplo
          importBtn.classList.add("hidden");

          // Prikaži CTA: "Pogledaj rezultate" (reload) + "Novi scrape" (reset)
          showReloadCta(id, forceEnabled);

          // Ako ima duplikata, prikaži detalje
          if (id.duplicates > 0 && id.duplicateDetails && id.duplicateDetails.length > 0) {
            showDuplicateDetails(id.duplicateDetails, id.duplicates);
          }

          // Auto-reload posle 2s da se vidi novi sadržaj (broj leadova,
          // status distribucija, poslednjih 50 leadova — sve je SSR u Astro-u,
          // pa ne možemo da apdejtujemo bez roundtrip-a). Countdown u dugmetu
          // daje korisniku jasnu povratnu vezu da se nešto dešava.
          var countdown = 2;
          reloadBtn.textContent = "Pogledaj rezultate (" + countdown + "s)";
          reloadTimer = setInterval(function () {
            countdown--;
            if (countdown <= 0) {
              clearInterval(reloadTimer);
              reloadTimer = null;
              window.location.reload();
              return;
            }
            reloadBtn.textContent = "Pogledaj rezultate (" + countdown + "s)";
          }, 1000);
        } else {
          importBtn.textContent = "Greška: " + (id.error || ir.statusText);
          importBtn.disabled = false;
        }
      } catch (e) {
        importBtn.textContent = "Greška: " + e.message;
        importBtn.disabled = false;
      }
    });

    // Prikazuje detaljnu listu duplikata (koji su, gde su već, zašto su preskočeni).
    function showDuplicateDetails(duplicates, dupCount) {
      var box = document.getElementById("duplicate-details");
      if (!box) return;
      // Grupisanje po kampanji (postojećoj)
      var byCampaign = {};
      duplicates.forEach(function (d) {
        var key = (d.existingCampaignName || "Bez kampanje") + " (id=" + d.existingCampaignId + ")";
        if (!byCampaign[key]) byCampaign[key] = [];
        byCampaign[key].push(d);
      });
      var html = '<div class="mt-3 rounded-md border border-amber-200 bg-amber-50 p-3 text-xs">';
      html += '<div class="mb-2 font-medium text-amber-900">' + dupCount + ' preskočeno jer već postoje u bazi:</div>';
      Object.keys(byCampaign).forEach(function (campName) {
        html += '<div class="mb-2"><div class="font-medium text-amber-800">Već u kampanji: ' + campName + '</div><ul class="ml-4 mt-1 space-y-0.5 list-disc">';
        byCampaign[campName].forEach(function (d) {
          var reasonMap = { web: "isti website", phone: "isti telefon", ime_grad: "isto ime+grad" };
          var reasonTxt = reasonMap[d.reason] || d.reason;
          var matchValShort = (d.matchValue || "").slice(0, 40);
          html += '<li><span class="font-medium">' + d.name + '</span> <span class="text-amber-700">(' + reasonTxt + ': ' + matchValShort + ')</span></li>';
        });
        html += '</ul></div>';
      });
      html += '</div>';
      box.innerHTML = html;
      box.classList.remove("hidden");
    }

    restartBtn.addEventListener("click", function () {
      // Ako je u toku auto-reload, otkaži
      if (reloadTimer) { clearInterval(reloadTimer); reloadTimer = null; }
      resetUI();
      // očisti i tekstualni unos? ostavi — korisnik obično hoće isti query
    });
  })();
</script>
