---
/**
 * LeadIdentity — renders a lead as a clear (category, city) pair plus the actual name.
 *
 * Rationale: many leads share nearly identical full names (e.g. "Cvećara Niš" vs
 * "Cvećara Beograd"). Showing category + city as a primary visual pair makes
 * rows in lists scannable and unambiguous.
 *
 * <LeadIdentity lead={lead} href={`/leads/${lead.id}`} compact />
 *
 * Variants:
 *   - default: two-line cell — line 1 "category — city", line 2 muted "name"
 *   - hero:    big — line 1 name big, line 2 "category · city" muted (for detail header)
 *   - compact: single line — "name" + smaller "(category — city)" inline
 *
 * If category or city is missing, falls back gracefully (no broken layout).
 * Lead name is always reachable via the link text.
 */
interface LeadLike {
  id: number;
  name: string;
  category?: string | null;
  city?: string | null;
}

interface Props {
  lead: LeadLike;
  href?: string;
  variant?: "default" | "hero" | "compact";
  class?: string;
}

const { lead, href, variant = "default", class: cls = "" } = Astro.props;

const name = (lead.name ?? "").trim();
const category = (lead.category ?? "").trim();
const city = (lead.city ?? "").trim();
const hasName = name.length > 0;
const hasCat = category.length > 0;
const hasCity = city.length > 0;

// Bold primary — the actual business name. Fall back to category, then city.
const identifier = hasName ? name
  : hasCat ? category
  : hasCity ? city
  : "—";

// Muted subtitle — any of (category, city) that isn't already the identifier.
const subParts = [];
if (hasCat && category !== identifier) subParts.push(category);
if (hasCity && city !== identifier) subParts.push(city);
const subtitle = subParts.join(" · ");
---
{href ? (
  <a
    href={href}
    class:list={[
      "group/lead block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/40 rounded-sm",
      cls,
    ]}
    title={`${lead.name}${hasCat ? ` (${category})` : ""}${hasCity ? ` — ${city}` : ""}`}
  >
    {variant === "default" && (
      <div class="flex items-baseline gap-2">
        <span class="truncate font-medium text-foreground group-hover/lead:text-primary">
          {identifier}
        </span>
        {lead.name && lead.name !== identifier && (
          <span class="truncate text-xs text-muted-foreground">· {lead.name}</span>
        )}
      </div>
    )}
    {variant === "compact" && (
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
        <span class="truncate font-medium text-foreground group-hover/lead:text-primary">
          {lead.name || identifier}
        </span>
        {hasCat && hasCity && (
          <span class="truncate text-xs text-muted-foreground">{category} · {city}</span>
        )}
        {hasCat && !hasCity && (
          <span class="truncate text-xs text-muted-foreground">{category}</span>
        )}
        {!hasCat && hasCity && (
          <span class="truncate text-xs text-muted-foreground">{city}</span>
        )}
      </div>
    )}
    {variant === "hero" && (
      <div>
        <div class="truncate text-2xl font-bold tracking-tight text-foreground group-hover/lead:text-primary">
          {lead.name}
        </div>
        {subtitle && (
          <div class="mt-1 truncate text-sm text-muted-foreground">{subtitle}</div>
        )}
      </div>
    )}
  </a>
) : (
  <div class={cls}>
    {variant === "default" && (
      <div class="flex items-baseline gap-2">
        <span class="truncate font-medium">{identifier}</span>
        {lead.name && lead.name !== identifier && (
          <span class="truncate text-xs text-muted-foreground">· {lead.name}</span>
        )}
      </div>
    )}
    {variant === "compact" && (
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
        <span class="truncate font-medium">{lead.name || identifier}</span>
        {hasCat && hasCity && (
          <span class="truncate text-xs text-muted-foreground">{category} · {city}</span>
        )}
      </div>
    )}
    {variant === "hero" && (
      <div>
        <div class="truncate text-2xl font-bold tracking-tight">{lead.name}</div>
        {subtitle && (
          <div class="mt-1 truncate text-sm text-muted-foreground">{subtitle}</div>
        )}
      </div>
    )}
  </div>
)}
