---
/**
 * Button — polished shared button.
 *
 * Variants: primary | secondary | outline | ghost | destructive | success
 * Sizes:    sm | md | lg | icon
 * Polymorphic: href → anchor, otherwise button.
 * Optional loading state (right spinner), optional icon (left).
 */
import { cn } from "~/lib/utils";
import Icon from "./Icon.astro";
import type { IconName } from "~/lib/icons";

interface Props {
  variant?: "primary" | "secondary" | "outline" | "ghost" | "destructive" | "success";
  size?: "sm" | "md" | "lg" | "icon";
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  formaction?: string;
  name?: string;
  value?: string;
  disabled?: boolean;
  loading?: boolean;
  icon?: IconName;
  iconRight?: IconName;
  fullWidth?: boolean;
  target?: string;
  rel?: string;
  "aria-label"?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  class: cls = "",
  formaction,
  name,
  value,
  disabled,
  loading,
  icon,
  iconRight,
  fullWidth,
  target,
  rel,
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-md font-medium whitespace-nowrap press focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-50 transition-[background-color,border-color,box-shadow,transform] duration-150";

const variants = {
  primary:
    "bg-primary text-primary-foreground shadow-sm hover:brightness-110 active:brightness-95",
  secondary:
    "bg-secondary text-secondary-foreground hover:bg-secondary/80",
  outline:
    "border border-border bg-background text-foreground hover:bg-accent hover:text-accent-foreground",
  ghost:
    "text-foreground hover:bg-accent hover:text-accent-foreground",
  destructive:
    "bg-destructive text-destructive-foreground shadow-sm hover:brightness-110 active:brightness-95",
  success:
    "bg-success text-success-foreground shadow-sm hover:brightness-110 active:brightness-95",
};

const sizes = {
  sm: "h-8 px-3 text-xs",
  md: "h-9 px-4 text-sm",
  lg: "h-10 px-6 text-sm",
  icon: "h-9 w-9 p-0",
};

const clsx = cn(base, variants[variant], sizes[size], fullWidth && "w-full", cls);

const Tag = href ? "a" : "button";
const extraTagAttrs = Tag === "button"
  ? { type, formaction, name, value, disabled }
  : { target, rel };
---
<Tag
  href={href as any}
  class={clsx}
  {...extraTagAttrs as any}
  {...rest}
>
  {loading ? (
    <svg class="h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
      <circle cx="12" cy="12" r="10" opacity="0.25" />
      <path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round" />
    </svg>
  ) : icon ? (
    <Icon name={icon} size={size === "sm" ? 14 : size === "lg" ? 18 : 16} />
  ) : null}
  <slot />
  {iconRight && !loading && <Icon name={iconRight} size={size === "sm" ? 14 : size === "lg" ? 18 : 16} />}
</Tag>
